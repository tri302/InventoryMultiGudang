@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manajemen System Settings";
}
<style>
    /* Status Default (Netral saat pertama kali dibuka) */
    .custom-input {
        border-color: #ced4da !important;
    }

    /* Status Hijau (Valid / Terisi) */
    .custom-input.is-valid-custom {
        border-color: #198754 !important;
        box-shadow: 0 0 0 0.25rem rgba(25, 135, 84, 0.25);
    }

    /* Status Merah (Invalid / Kosong) */
    .custom-input.is-invalid-custom {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
    }

    /* Sembunyikan pesan error secara default */
    .error-message {
        display: none;
        color: #dc3545;
        font-size: 0.875em;
        margin-top: 0.25rem;
    }
</style>
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">System Settings Management</h4>
            <p class="text-muted small mb-0">Kelola data pengaturan dan konfigurasi sistem dengan modal.</p>
        </div>
        <!-- Tombol Trigger Modal Tambah -->
        <button type="button" id="btnAddModal" class="btn btn-success rounded-pill px-4 btn-sm">
            <i class="bi bi-plus-lg"></i> Tambah Setting Baru
        </button>
    </div>

    <!-- Tabel Data -->
    <div class="card card-custom p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle" id="tableSettings">
                <thead class="table-light">
                    <tr>
                        <th>Site Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th class="text-center">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Data akan dimuat via AJAX -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL FORM (TAMBAH / EDIT) -->
<div class="modal fade" id="settingModal" tabindex="-1" aria-labelledby="settingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="formSettingModal" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="settingModalLabel">Tambah Setting</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Hidden ID untuk mode Edit -->
                    <input type="hidden" id="SettingId" name="Id" value="0">
                    <div class="mb-3">
                        <label class="form-label">Company Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control custom-input" id="ModalSiteName" name="SiteName"
                               required>
                        <div class="error-message" id="error-SiteName">Company Name wajib diisi.</div>

                        <div class="mb-3">
                            <label class="form-label">Company Description</label>
                            <textarea class="form-control custom-input" id="ModalSiteDescription" name="SiteDescription"
                                      rows="2"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Company Address</label>
                            <textarea class="form-control custom-input" id="ModalCompanyAddress" name="CompanyAddress"
                                      rows="2"></textarea>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Phone Number <span class="text-danger">*</span></label>
                                <input type="text" class="form-control custom-input" id="ModalCompanyPhone"
                                       name="CompanyPhone" required>
                                <div class="error-message" id="error-CompanyPhone">Nomor telepon wajib diisi.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email Address <span class="text-danger">*</span></label>
                                <input type="email" class="form-control custom-input" id="ModalCompanyEmail"
                                       name="CompanyEmail" required>
                                <div class="error-message" id="error-CompanyEmail">Format email tidak valid atau kosong.
                                </div>
                            </div>
                        </div>
                        <!-- Modal Footer -->
                        <div class="modal-footer d-flex justify-content-center gap-2 border-top-0 bg-white pt-0">
                            <button type="button" class="btn btn-batal-modal btn-sm" data-bs-dismiss="modal">
                                <i class="bi bi-arrow-90deg-left"></i>
                                Batal
                            </button>
                            <button type="submit" id="btnSaveModal" class="btn btn-success btn-sm">
                                <i class="bi bi-check-lg me-1"></i>
                                Simpan
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @section Scripts {
        <script src="~/js/SystemSettings.js"></script>
    }