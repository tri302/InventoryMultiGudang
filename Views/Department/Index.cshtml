@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manajemen Department";
}
@Html.AntiForgeryToken()

<div class="container-fluid">

    <!-- HEADER SECTION -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold text-indigo-dark mb-1">Manajemen Department</h1>
            <p class="text-muted small mb-0">Kelola data Department organisasi sebagai tujuan penugasan aset inventaris perusahaan.</p>
        </div>
        <div>
            <button class="btn btn-success rounded-pill px-4 btn-sm" id="btnTambahDepartemen">
                <i class="bi bi-plus-lg"></i> Tambah Department
            </button>
        </div>
    </div>

    <!-- FILTER & SEARCH BAR -->
    <div class="card border-0 shadow-sm p-3 mb-4" style="border-radius: 12px;">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-4">
                <div class="input-group">
                    <span class="input-group-text border-end-0 bg-white text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="searchInput" class="form-control border-start-0 ps-0" placeholder="Cari kode atau nama Department...">
                </div>
            </div>
        </div>
    </div>

    <!-- TABLE AREA CONTAINING AJAX PARTIAL -->
    <div id="tableContainer">
        <!-- Render Partial Table Ajax -->
    </div>
</div>

@await Html.PartialAsync("Create", new InventoryMultiGudang.ViewModels.DepartmentCreateViewModel())
@await Html.PartialAsync("Edit", new InventoryMultiGudang.ViewModels.DepartmentEditViewModel())
@await Html.PartialAsync("Delete")

@section Scripts {
    <script src="~/js/department.js"></script>
}