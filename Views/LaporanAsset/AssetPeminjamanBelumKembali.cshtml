@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Laporan Aset Belum Kembali";
}

<!-- Input Search -->
<div class="mb-3">
    <div class="input-group style-search" style="max-width: 380px;">
        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
        <input type="text" id="searchInput" class="form-control border-start-0 ps-0" placeholder="Cari kode, peminjam, barang, SN... (Tekan Enter)" style="font-size: 0.85rem;">
    </div>
</div>

<!-- Tabel Konten Peminjaman Belum Kembali -->
<div class="card border-0 shadow-sm overflow-hidden mb-3" style="border: 1px solid #e2e8f0 !important; border-radius: 12px;">
    <div class="table-responsive">
        <table class="table align-middle mb-0" style="font-size: 0.85rem;">
            <thead class="table-light text-uppercase text-muted" style="font-size: 0.725rem; letter-spacing: 0.05em; background-color: #f8fafc;">
                <tr>
                    <th class="ps-4 py-3" style="width: 15%;">Kode Pinjam</th>
                    <th style="width: 20%;">Peminjam (Borrower)</th>
                    <th style="width: 25%;">Aset yang Dipinjam (SN)</th>
                    <th style="width: 20%;">Tgl Pinjam / Jatuh Tempo</th>
                    <th style="width: 15%;">Status</th>
                    <th class="pe-4 text-center" style="width: 5%;">Kontak</th>
                </tr>
            </thead>
            <tbody id="tableBody" class="text-secondary">
                <!-- Data dinamis akan dimasukkan melalui AJAX -->
            </tbody>
        </table>
    </div>
</div>

<!-- Footer Info & Pagination Layout -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 px-1 mb-4" style="font-size: 0.85rem;">
    <div class="text-secondary" id="tableInfo">
        Menampilkan <span class="fw-bold text-dark">0</span> dari <span class="fw-bold text-dark">0</span> unit.
    </div>
    <nav>
        <ul class="pagination pagination-sm mb-0" id="paginationContainer">
            <!-- Pagination Render -->
        </ul>
    </nav>
</div>

@section Scripts {
   <script src="~/js/AssetPeminjamanBelumKembali.js"></script>
}