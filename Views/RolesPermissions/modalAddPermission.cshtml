<div class="modal fade" id="modalAddPermission" tabindex="-1" aria-labelledby="modalAddPermissionLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm" style="max-width: 400px;">
        <div class="modal-content border-0 px-2" style="border-radius: 12px; background-color: #ffffff; box-shadow: 0 4px 20px rgba(0,0,0,0.05);">
            <div class="modal-header border-bottom-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">
                <h5 class="modal-title fw-bold text-dark" id="modalAddPermissionLabel" style="font-size: 1.15rem; color: #0f172a !important;">Add Security Permission</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close" style="font-size: 0.75rem; color: #94a3b8;"></button>
            </div>
            <div class="modal-body px-4 py-2">
                <form id="formAddPermission">
                    <div class="mb-2">
                        <label for="permissionNameInput" class="form-label text-uppercase fw-semibold mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px; color: #64748b;">Permission Name</label>
                        <input type="text" class="form-control px-3" id="permissionNameInput" placeholder="e.g. view analytics" style="border-color: #e2e8f0; background-color: #f8fafc; font-size: 0.9rem; padding-top: 10px; padding-bottom: 10px; border-radius: 8px; color: #334155;">
                        <div id="permNameInputError" class="invalid-feedback-custom">Permission name wajib diisi!</div>
                    </div>
                    <!-- Input Kategori Permission (Dropdown) -->
                    <div class="mb-2">
                        <label for="permissionCategoryInput" class="form-label text-uppercase fw-semibold mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px; color: #64748b;">Category</label>
                        <select class="form-select px-3" id="permissionCategoryInput" style="border-color: #e2e8f0; background-color: #f8fafc; font-size: 0.9rem; padding-top: 10px; padding-bottom: 10px; border-radius: 8px; color: #334155;">
                            <option value="General">General</option>
                            <option value="Navigation & View">Navigation & View</option>
                            <option value="User Management">User Management</option>
                            <option value="System Settings">System Settings</option>
                            <option value="Audit Logs">Audit Logs</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label for="permissionTypeInput" class="form-label text-uppercase fw-semibold mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px; color: #64748b;">Type</label>
                        <select class="form-select px-3" id="permissionTypeInput" style="border-color: #e2e8f0; background-color: #f8fafc; font-size: 0.9rem; padding-top: 10px; padding-bottom: 10px; border-radius: 8px; color: #334155;">
                            <option value="Custom">Custom</option>
                            <option value="System Core">System Core</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer d-flex justify-content-center gap-2">
                <button type="button" class="btn btn-cancel btn-sm" data-bs-dismiss="modal">
                    <i class="bi bi-arrow-90deg-left"></i> Batal
                </button>
                <button type="button" id="btnSavePermission" class="btn btn-save btn-sm">
                    <i class="bi bi-check-lg me-1"></i> Simpan
                </button>
            </div>
        </div>
    </div>
</div>
