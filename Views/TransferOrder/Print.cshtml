@using InventoryMultiGudang.Models
@model InventoryMultiGudang.ViewModels.TransferOrderDetailViewModel
@{
Layout = null;

// Gunakan Class Bootstrap baku
var badgeClass = Model.Status switch
{
StatusTransfer.DalamPerjalanan => "bg-warning text-dark",
StatusTransfer.Diterima => "bg-success text-white",
_ => "bg-secondary text-white"
};

// Format teks enum menjadi ber-spasi untuk UI
var displayStatus = Model.Status switch
{
StatusTransfer.DalamPerjalanan => "Dalam Perjalanan",
StatusTransfer.Diterima => "Diterima",
_ => Model.Status.ToString()
};
}
<!DOCTYPE html>
<html lang="id">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Surat Jalan Mutasi - @Model.NoReferensi</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f8f9fa;
        color: #1e293b;
      }

      .print-container {
        max-width: 900px;
        margin: 20px auto;
        background: #fff;
        padding: 40px;
        border-radius: 8px;
      }

      .border-thick {
        border-bottom: 2px solid #000;
      }

      .text-indigo-dark {
        color: #1e1b4b;
      }

      .text-xs {
        font-size: 0.75rem;
      }

      @@media print {
        .no-print {
          display: none !important;
        }

        body {
          background-color: #fff;
        }

        .print-container {
          max-width: 100%;
          margin: 0;
          padding: 0;
          border: none;
          box-shadow: none;
        }
      }
    </style>
  </head>

  <body>

    <!-- Floating Bar Top (No Print) -->
    <div class="no-print bg-white border-bottom py-2 px-4 d-flex justify-content-between align-items-center sticky-top shadow-sm">
      <div class="d-flex align-items-center gap-2">
        <div class="rounded-2 bg-danger bg-opacity-10 text-danger p-2 fw-bold d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
            <i class="bi bi-file-earmark-pdf-fill fs-5"></i>
        </div>
        <div>
          <h6 class="mb-0 fw-bold">Pratinjau Bukti Mutasi</h6>
          <small class="text-muted">Laporan diatur dalam tata letak khusus kertas cetak (Portrait).</small>
        </div>
      </div>
      <div class="d-flex gap-2">
        <button onclick="window.close()" class="btn btn-secondary btn-sm rounded-3"><i class="bi bi-x-lg"></i> Tutup
          Halaman</button>
        <button onclick="window.print()" class="btn btn-success btn-sm rounded-3"><i class="bi bi-printer"></i>
          Cetak Sekarang</button>
      </div>
    </div>

    <!-- Document Body -->
    <div class="print-container shadow-sm">
      <!-- Header Document -->
      <div class="row align-items-start pb-3 mb-3 border-thick">
        <div class="col-7">
          <!-- Nama Perusahaan Dinamis -->
          <h3 class="fw-bold text-dark mb-1">@ViewBag.SiteName</h3>

          <!-- Deskripsi Perusahaan Dinamis -->
          <p class="text-muted small mb-1" style="font-size: 10px; line-height: 1.2;">
            @ViewBag.SiteDescription
          </p>

          <!-- Alamat, Telepon, & Email Dinamis -->
          <p class="text-muted small mb-0" style="font-size: 11px;">
            @ViewBag.CompanyAddress<br>
            Telp: @ViewBag.CompanyPhone | Email: @ViewBag.CompanyEmail
          </p>
        </div>
        <div class="col-5 text-end">
          <h4 class="fw-bold mb-1">SURAT JALAN MUTASI</h4>
          <div class="small text-muted mb-1">Nomor Dokumen: <strong>@Model.NoReferensi</strong></div>
          <div class="small text-muted mb-1">Status: <span class="badge @badgeClass px-3 py-2 rounded-pill fw-bold" style="font-size: 0.8rem;">
              @displayStatus
            </span>
          </div>
        </div>
      </div>

      <!-- Detail Informasi Gudang Pengirim & Penerima -->
      <div class="row g-3 mb-3">
        <div class="col-6">
          <div class="border rounded-3 p-3 h-100 bg-light-subtle">
            <span class="text-uppercase text-muted fw-bold d-block mb-1" style="font-size: 10px;">GUDANG ASAL
              (PENGIRIM)</span>
            <h6 class="fw-bold mb-1 text-indigo-dark">@Model.GudangAsalNama</h6>
            <small class="text-muted d-block fw-semibold mb-1" style="font-size: 11px;">Kode:
              @Model.GudangAsalKode</small>
            <small class="text-muted d-block" style="font-size: 11px;">@Model.GudangAsalAlamat</small>
          </div>
        </div>
        <div class="col-6">
          <div class="border rounded-3 p-3 h-100 bg-light-subtle">
            <span class="text-uppercase text-muted fw-bold d-block mb-1" style="font-size: 10px;">GUDANG TUJUAN
              (PENERIMA)</span>
            <h6 class="fw-bold mb-1 text-indigo-dark">@Model.GudangTujuanNama</h6>
            <small class="text-muted d-block fw-semibold mb-1" style="font-size: 11px;">Kode:
              @Model.GudangTujuanKode</small>
            <small class="text-muted d-block" style="font-size: 11px;">@Model.GudangTujuanAlamat</small>
          </div>
        </div>
      </div>

      <!-- Meta Timeline Tanggal -->
      <div class="border rounded-3 p-2 px-3 mb-4 bg-light">
        <div class="row text-center small text-muted">
          <div class="col-4 border-end">
            <span class="d-block text-uppercase fw-bold" style="font-size: 9px;">Tanggal Dibuat</span>
            <span class="fw-bold text-dark">@Model.TanggalDibuat.ToString("dd MMM yyyy, HH.mm")</span>
          </div>
          <div class="col-4 border-end">
            <span class="d-block text-uppercase fw-bold" style="font-size: 9px;">Tanggal Dikirim</span>
            <span class="fw-bold text-dark">@(Model.TanggalDikirim.HasValue?
              Model.TanggalDikirim.Value.ToString("dd MMM yyyy, HH.mm") : "-")</span>
          </div>
          <div class="col-4">
            <span class="d-block text-uppercase fw-bold" style="font-size: 9px;">Tanggal Diterima</span>
            <span class="fw-bold text-dark">@(Model.TanggalDiterima.HasValue?
              Model.TanggalDiterima.Value.ToString("dd MMM yyyy, HH.mm") : "-")</span>
          </div>
        </div>
      </div>

      <!-- Items Table -->
      <div class="table-responsive mb-4">
        <table class="table table-bordered align-middle text-center small mb-0">
          <thead class="bg-light text-uppercase fw-bold text-muted" style="font-size: 10px;">
            <tr>
              <th width="5%">NO</th>
              <th class="text-start" width="35%">PRODUK / SKU</th>
              <th width="12%">UOM</th>
              <th width="16%">KUANTITAS KIRIM</th>
              <th width="16%">KUANTITAS TERIMA</th>
              <th width="16%">CATATAN FISIK</th>
            </tr>
          </thead>
          <tbody>
            @if (Model.Items != null && Model.Items.Any())
            {
            int no = 1;
            foreach (var item in Model.Items)
            {
            <tr>
              <td>@(no++)</td>
              <td class="text-start">
                <div class="fw-bold text-indigo-dark">@item.NamaProduk</div>
                <small class="text-muted d-block">@item.Sku</small>
                @if (!string.IsNullOrEmpty(item.SerialNumber))
                {
                <small class="text-muted" style="font-size: 10px;">SN: @item.SerialNumber</small>
                }
              </td>
              <td>@item.Satuan</td>
              <td class="fw-bold fs-6">@item.QtyPermintaan</td>
              <td class="fw-bold fs-6">@(Model.Status == StatusTransfer.Diterima ? item.QtyDiterima.ToString()
                : "-")</td>
              <td></td>
            </tr>
            }
            }
            else
            {
            <tr>
              <td colspan="6" class="text-center py-3 text-muted">Tidak ada data produk.</td>
            </tr>
            }
          </tbody>
        </table>
      </div>

      <!-- Notes -->
      <div class="border rounded-3 p-3 mb-4">
        <span class="text-uppercase text-muted fw-bold d-block mb-1" style="font-size: 10px;">CATATAN DOKUMEN</span>
        <p class="mb-0 small text-dark">@(string.IsNullOrWhiteSpace(Model.Catatan) ? "-" : Model.Catatan)</p>
      </div>

      <!-- Signatures (3 Pihak) -->
      <div class="row text-center mt-5 pt-2">
        <div class="col-4">
          <span class="text-uppercase text-muted fw-bold d-block mb-5" style="font-size: 10px;">DISIAPKAN OLEH
            (ASAL)</span>
          <div class="fw-bold border-bottom d-inline-block px-4 pb-1 mb-1">@Model.DibuatOleh</div>
          <div class="text-muted small" style="font-size: 11px;">Staff Gudang Asal</div>
        </div>
        <div class="col-4">
          <span class="text-uppercase text-muted fw-bold d-block mb-5" style="font-size: 10px;">KURIR / PEMBAWA
            BARANG</span>
          <div class="fw-bold border-bottom d-inline-block px-4 pb-1 mb-1">(...........................)</div>
          <div class="text-muted small" style="font-size: 11px;">Sopir / Jasa Ekspedisi</div>
        </div>
        <div class="col-4">
          <span class="text-uppercase text-muted fw-bold d-block mb-5" style="font-size: 10px;">DITERIMA OLEH
            (TUJUAN)</span>
          <div class="fw-bold border-bottom d-inline-block px-4 pb-1 mb-1">(...........................)</div>
          <div class="text-muted small" style="font-size: 11px;">Staff Gudang Tujuan</div>
        </div>
      </div>

      <!-- Footer Document -->      
        <div class="text-center text-muted fw-bold mt-5 pt-4 border-top" style="font-size: 10px; letter-spacing: 1px;">
            SURAT JALAN INI MERUPAKAN BUKTI SAH MUTASI STOK INTERNAL SYSTEM @ViewBag.SiteName.ToUpper()
        </div>
    </div>
  </body>
</html>