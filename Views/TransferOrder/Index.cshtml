@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Mutasi Antar-Gudang";
}
<style>
    /* Mencegah layar gelap saat transisi halaman / reload */
html, body {
    background-color: #f8f9fa !important;
    color: #1e293b !important;
}
.form-control, 
.form-select, 
.form-input-custom,
.form-control-custom {
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 0.6rem 0.9rem;
    font-size: 0.95rem;
    color: #1e293b !important;
    font-weight: 500;
    transition: all 0.2s ease;
}
    ::before, ::after {
        --tw-content: "";
    }

    element {
    }

    .text-amber-700 {
        --tw-text-opacity: 1;
        color: rgb(180 83 9/var(--tw-text-opacity,1));
    }

    .font-semibold {
        font-weight: 600;
    }

    .text-xs {
        font-size: .75rem;
        line-height: 1rem;
    }

    .py-1 {
        padding-top: .25rem;
        padding-bottom: .25rem;
    }

    .px-3 {
        padding-left: .75rem;
        padding-right: .75rem;
    }

    .bg-amber-50 {
        --tw-bg-opacity: 1;
        background-color: rgb(255 251 235/var(--tw-bg-opacity,1));
    }

    .border-amber-200 {
        --tw-border-opacity: 1;
        border-color: rgb(253 230 138/var(--tw-border-opacity,1));
    }

    .border {
        border-width: 1px;
    }

    .rounded-full {
        border-radius: 9999px;
    }

    .gap-1\.5 {
        gap: .375rem;
    }

    .items-center {
        align-items: center;
    }

    .inline-flex {
        display: inline-flex;
    }

    *, ::before, ::after {
        box-sizing: border-box;
        border: 0 solid #e5e7eb;
        border-top-width: 0px;
        border-top-color: rgb(229, 231, 235);
        border-right-width: 0px;
        border-right-color: rgb(229, 231, 235);
        border-bottom-width: 0px;
        border-bottom-color: rgb(229, 231, 235);
        border-left-width: 0px;
        border-left-color: rgb(229, 231, 235);
    }

    *, ::before, ::after, ::backdrop {
    }

    .text-slate-900 {
        --tw-text-opacity: 1;
        color: rgb(15 23 42/var(--tw-text-opacity,1));
    }

    .bg-slate-50 {
        --tw-bg-opacity: 1;
    }

    .font-sans {
        font-family: Figtree,ui-sans-serif,system-ui,sans-serif,Apple Color Emoji,Segoe UI Emoji,Segoe UI Symbol,Noto Color Emoji;
    }

    body {
        line-height: inherit;
    }

    html, :host {
        -webkit-text-size-adjust: 100%;
        tab-size: 4;
        font-feature-settings: normal;
        font-variation-settings: normal;
        font-family: Figtree,ui-sans-serif,system-ui,sans-serif,Apple Color Emoji,Segoe UI Emoji,Segoe UI Symbol,Noto Color Emoji;
        line-height: 1.5;
    }
    /* 1. Fix Flexbox pada Input Group yang berisi Select2 */
    .input-group .select2-container--default {
        flex: 1 1 auto !important;
        width: 1% !important;
    }

        /* 2. Style Box Dropdown Utama (Gudang Asal & Tujuan) */
        .input-group .select2-container--default .select2-selection--single {
            height: 38px !important;
            border: 1px solid #dee2e6 !important;
            border-left: 0 !important; /* Hilangkan border kiri agar menyatu dengan ikon */
            border-top-left-radius: 0 !important;
            border-bottom-left-radius: 0 !important;
            border-top-right-radius: 0.375rem !important;
            border-bottom-right-radius: 0.375rem !important;
            display: flex !important;
            align-items: center !important;
        }

    /* 3. Style Dropdown Produk (Tanpa Input Group) */
    .select2-container--default .select2-selection--single {
        height: 38px !important;
        border: 1px solid #dee2e6 !important;
        border-radius: 0.375rem !important;
        display: flex !important;
        align-items: center !important;
    }

        /* 4. Perbaikan Teks & Arrow di dalam Select2 */
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            color: #212529 !important;
            padding-left: 0.75rem !important;
            line-height: normal !important;
            width: 100% !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px !important;
            position: absolute !important;
            top: 50% !important;
            transform: translateY(-50%) !important;
            right: 8px !important;
        }

    /* 5. State Focus & Highlight Warna Indigo / Bootstrap */
    .select2-container--default.select2-container--focus .select2-selection--single {
        border-color: #86b7fe !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15) !important;
    }

    /* 6. Samakan Tinggi Icon Group */
    .input-group-text {
        height: 38px !important;
        background-color: #f8f9fa !important;
    }
</style>
<div class="container-fluid py-4 px-4">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-indigo-dark mb-1">Mutasi Antar-Gudang (Transfer Order)</h1>
            <p class="text-muted small mb-0">Buat pesanan transfer barang lintas koordinat gudang fisik, pantau status, dan catat penerimaan produk.</p>
        </div>
        <button class="btn btn-success rounded-pill px-4 btn-sm" data-bs-toggle="modal" data-bs-target="#modalTransferOrder">
            <i class="bi bi-plus-lg"></i> Buat Transfer Order
        </button>
    </div>

    <!-- Filter Card Area -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="row align-items-center g-3">
                <div class="col-12 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="filterSearch" class="form-control border-start-0 ps-0" placeholder="Cari nomor transfer (E.g. TO-)...">
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <select id="filterGudang" class="form-select select-custom-focus">
                        <option value="">Semua Gudang</option>
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <select id="filterStatus" class="form-select select-custom-focus">
                        <option value="">Semua Status</option>
                        <option value="DalamPerjalanan">Dalam Perjalanan</option>
                        <option value="Diterima">Diterima</option>
                        <option value="Pending">Pending</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 text-md-end text-muted small fw-semibold">
                    Total Dokumen: <span id="totalDokumen" class="text-indigo-dark fs-6 fw-bold">0</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Responsive Card Area -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0" style="min-width: 1000px;">
                <thead>
                    <tr class="text-uppercase small fw-bold tracking-wider text-muted border-bottom">
                        <th class="py-3 px-4">Nomor Dokumen</th>
                        <th class="py-3">Gudang Asal</th>
                        <th class="py-3">Gudang Tujuan</th>
                        <th class="py-3 text-center">Status</th>
                        <th class="py-3">Tanggal Dibuat</th>
                        <th class="py-3">Pembuat</th>
                        <th class="py-3 text-center">Aksi</th>
                    </tr>
                </thead>
                <tbody id="toTableBody">
                    <!-- Loaded via Ajax -->
                </tbody>
            </table>
        </div>

        <!-- Footer & Pagination -->
        <div class="card-footer bg-white border-top py-3 px-4" id="paginationFooter" style="display: none;">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                <div class="text-muted small" id="paginationInfo">                    
                </div>
                <div id="paginationContainer">                    
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("~/Views/TransferOrder/Create.cshtml")
@await Html.PartialAsync("Delete", new InventoryMultiGudang.ViewModels.TransferOrderDetailViewModel())
@section Scripts {
    <script src="~/js/TransferOrder.js"></script>
}