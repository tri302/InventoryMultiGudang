@{
Layout = "_AdminLayout";
ViewData["Title"] = "Manajemen Laporan Barang Masuk/Keluar";
}
<style>
.form-control, 
.form-select, 
.form-input-custom,
.form-control-custom {
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 0.6rem 0.9rem;
    font-size: 0.95rem;
    color: #1e293b !important;
    font-weight: 500;
    transition: all 0.2s ease;
}
</style>
<!-- Main Content Container -->
<div class="container-fluid">

  <!-- Header Section -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
      <h4 class="fw-bold text-indigo-dark mb-1">Laporan Barang Masuk/Keluar</h4>
      <p class="text-muted small mb-0">Rekapitulasi logistik harian, pengeluaran barang konsumtif, dan penerimaan
        inventory masuk.</p>
    </div>
    <!-- Tombol Cetak Laporan Langsung Cetak -->
    <form asp-action="Report" asp-controller="LaporanBarangMasukKeluar" method="get" target="_blank" class="d-inline">
      <!-- Hidden inputs untuk menangkap nilai dari form filter di bawahnya -->
      <input type="hidden" id="hiddenTanggalMulai" name="tanggalMulai" />
      <input type="hidden" id="hiddenTanggalSelesai" name="tanggalSelesai" />
      <input type="hidden" id="hiddenGudangId" name="gudangId" />
      <input type="hidden" id="hiddenTipeTransaksi" name="tipeTransaksi" />
      <input type="hidden" id="hiddenProdukId" name="produkId" />

      <button type="submit" onclick="syncFilterCetak()" class="btn btn-success btn-sm px-3 d-flex align-items-center gap-1 shadow-sm" style="border-color: var(--border-color); background: #fff; color: #198754;">
        <i class="bi bi-printer"></i> Cetak Laporan
      </button>
    </form>
  </div>

  <!-- Filter Form Row -->
  <div class="card border-0 shadow-sm p-4 mb-4" style="border: 1px solid var(--border-color) !important; border-radius: 12px;">
    <div class="row g-3">
      <!-- Tanggal Mulai -->
      <div class="col-12 col-md-2">
        <label class="form-label font-monospace small text-muted fw-bold mb-2">Tanggal Mulai</label>
        <input type="text" id="tanggalMulai" class="form-control form-input-custom text-muted">
      </div>
      <!-- Tanggal Selesai -->
      <div class="col-12 col-md-2">
        <label class="form-label font-monospace small text-muted fw-bold mb-2">Tanggal Selesai</label>
        <input type="text" id="tanggalSelesai" class="form-control form-input-custom text-muted">
      </div>
      <!-- Gudang (Dinamis dari database tbl gudang, max 5 data + ajax live search) -->
      <div class="col-12 col-md-3">
        <label class="form-label font-monospace small text-muted fw-bold mb-2">Gudang</label>
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted" style="border-color: var(--border-color);"><i class="bi bi-building"></i></span>
          <select class="form-select form-select-custom border-start-0 ps-0" id="selectGudang">
            <option selected value="">Semua Gudang</option>
          </select>
        </div>
      </div>
      <!-- Tipe Transaksi -->
      <div class="col-12 col-md-2">
        <label class="form-label font-monospace small text-muted fw-bold mb-2">Tipe Transaksi</label>
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted" style="border-color: var(--border-color);"><i class="bi bi-arrow-left-right"></i></span>
          <select class="form-select form-select-custom border-start-0 ps-0" id="selectTipeTransaksi">
            <option selected value="">Semua Tipe</option>
            <option value="Stock In">Barang Masuk (Stock In)</option>
            <option value="Stock Out">Barang Keluar (Stock Out)</option>
          </select>
        </div>
      </div>
      <!-- Filter Produk (Dinamis dari database tbl produk, max 5 data + ajax live search) -->
      <div class="col-12 col-md-3">
        <label class="form-label font-monospace small text-muted fw-bold mb-2">Filter Produk</label>
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted" style="border-color: var(--border-color);"><i class="bi bi-search"></i></span>
          <select class="form-select form-select-custom border-start-0 ps-0" id="selectNamaProduk">
            <option selected value="">--Pilih--</option>
          </select>
        </div>
      </div>
    </div>
  </div>

  <!-- Metrics Cards Summary Row (Dinamis dari DB) -->
  <div class="row g-3 mb-4">
    <!-- Total Masuk -->
    <div class="col-12 col-md-4">
      <div class="card border-0 shadow-sm p-3 d-flex flex-row align-items-center gap-3" style="border: 1px solid var(--border-color) !important; border-radius: 12px;">
        <div class="d-flex align-items-center justify-content-center bg-success-subtle text-success rounded-3" style="width: 48px; height: 48px; font-size: 1.25rem;">
          <i class="bi bi-arrow-down-left"></i>
        </div>
        <div>
          <span class="font-monospace small text-muted d-block fw-bold" style="font-size: 0.7rem; letter-spacing: 0.05em;">TOTAL UNIT MASUK</span>
          <h4 class="fw-bold text-indigo-dark mb-0"><span id="metricTotalMasuk">0</span> <span class="fs-6 fw-normal text-muted">unit</span></h4>
        </div>
      </div>
    </div>
    <!-- Total Keluar -->
    <div class="col-12 col-md-4">
      <div class="card border-0 shadow-sm p-3 d-flex flex-row align-items-center gap-3" style="border: 1px solid var(--border-color) !important; border-radius: 12px;">
        <div class="d-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-3" style="width: 48px; height: 48px; font-size: 1.25rem;">
          <i class="bi bi-arrow-up-right"></i>
        </div>
        <div>
          <span class="font-monospace small text-muted d-block fw-bold" style="font-size: 0.7rem; letter-spacing: 0.05em;">TOTAL UNIT KELUAR</span>
          <h4 class="fw-bold text-indigo-dark mb-0"><span id="metricTotalKeluar">0</span> <span class="fs-6 fw-normal text-muted">unit</span></h4>
        </div>
      </div>
    </div>
    <!-- Mutasi Bersih -->
    <div class="col-12 col-md-4">
      <div class="card border-0 shadow-sm p-3 d-flex flex-row align-items-center gap-3" style="border: 1px solid var(--border-color) !important; border-radius: 12px;">
        <div class="d-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-3" style="width: 48px; height: 48px; font-size: 1.25rem;">
          <i class="bi bi-graph-up-arrow"></i>
        </div>
        <div>
          <span class="font-monospace small text-muted d-block fw-bold" style="font-size: 0.7rem; letter-spacing: 0.05em;">MUTASI BERSIH (NET)</span>
          <h4 class="fw-bold text-success mb-0"><span id="metricMutasiBersih">0</span> <span class="fs-6 fw-normal text-muted">unit</span></h4>
        </div>
      </div>
    </div>
  </div>

  <!-- Data Table Card -->
  <div class="card border-0 shadow-sm overflow-hidden mb-3" style="border: 1px solid var(--border-color) !important; border-radius: 12px;">
    <div class="table-responsive">
      <table class="table align-middle table-hover mb-0" style="font-size: 0.85rem;">
        <thead class="table-light text-uppercase font-monospace text-muted" style="font-size: 0.725rem; letter-spacing: 0.05em;">
          <tr>
            <th class="ps-4 py-3" style="width: 15%;">Tanggal & Waktu</th>
            <th style="width: 15%;">No. Referensi</th>
            <th style="width: 18%;">Gudang</th>
            <th class="text-center" style="width: 12%;">Tipe Transaksi</th>
            <th style="width: 16%;">Supplier / Mitra</th>
            <th class="text-center" style="width: 8%;">Jumlah SKU</th>
            <th class="text-end" style="width: 8%;">Total Unit</th>
            <th class="pe-4" style="width: 8%;">Pencatat</th>
          </tr>
        </thead>
        <tbody id="tabelLaporanBody" class="text-secondary">
          <!-- Data akan dirender secara dinamis melalui JavaScript AJAX.
          Jika kosong, otomatis menampilkan fallback: "Belum ada data untuk ditampilkan !" -->
        </tbody>
      </table>
    </div>
  </div>
</div>

@section Scripts {
<script src="~/js/LaporanBarangMasukKeluar.js"></script>
<script>  
  flatpickr("#tanggalMulai, #tanggalSelesai", {
    dateFormat: "d-m-Y",
    locale: "id", // opsional: format Bahasa Indonesia
    allowInput: true
  });
</script>
}