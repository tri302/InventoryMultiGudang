@model InventoryMultiGudang.ViewModels.LaporanBarangMasukKeluarIndexViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cetak Laporan Barang Masuk / Keluar</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background-color: #f8f9fa;
                color: #1e293b;
            }

            .print-container {
                max-width: 900px;
                margin: 20px auto;
                background: #fff;
                padding: 40px;
                border-radius: 8px;
                box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            }

            .card-report {
                border: 1px solid #cbd5e1;
                border-radius: 6px;
                margin-bottom: 20px;
                overflow: hidden;
                background: #fff;
            }

            .card-report-header {
                background-color: #f1f5f9;
                padding: 10px 15px;
                border-bottom: 1px solid #cbd5e1;
                font-size: 13px;
            }

            .badge-sn {
                background-color: #e2e8f0;
                color: #334155;
                padding: 2px 6px;
                font-size: 11px;
                border-radius: 4px;
                border: 1px solid #cbd5e1;
                display: inline-block;
            }

            .signature-section {
                margin-top: 50px;
            }

            .signature-space {
                height: 70px;
            }

            @@media print {
                .no-print {
                    display: none !important;
                }

                body {
                    background-color: #fff;
                }

                .print-container {
                    max-width: 100%;
                    margin: 0;
                    padding: 0;
                    border: none;
                    box-shadow: none;
                }
            }
    </style>
</head>

<body>
    <div
        class="no-print bg-white border-bottom py-2 px-4 d-flex justify-content-between align-items-center sticky-top shadow-sm">
        <div class="d-flex align-items-center gap-2">
            <div class="avatar-box bg-light text-danger d-flex align-items-center justify-content-center rounded"
                 style="width: 36px; height: 36px;">
                <i class="bi bi-file-earmark-pdf-fill fs-5"></i>
            </div>
            <div>
                <h6 class="mb-0 fw-bold">Pratinjau Cetak Berita Acara</h6>
                <small class="text-muted">Gunakan tombol cetak untuk mencetak atau menyimpan sebagai PDF.</small>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button onclick="window.close()" class="btn btn-secondary btn-sm rounded-3"><i class="bi bi-x-lg"></i> Tutup
                Halaman</button>
                <button onclick="window.print()" class="btn btn-success btn-sm rounded-3"><i class="bi bi-printer"></i>
                    Cetak Sekarang
                </button>
            </div>
        </div>

        <input type="hidden" id="hiddenTanggalMulai" name="tanggalMulai" />
        <input type="hidden" id="hiddenTanggalSelesai" name="tanggalSelesai" />
        <input type="hidden" id="hiddenGudangId" name="gudangId" />
        <input type="hidden" id="hiddenTipeTransaksi" name="tipeTransaksi" />
        <input type="hidden" id="hiddenProdukId" name="produkId" />

        <div class="container print-container">
            <!-- Judul Utama Laporan -->
            <div class="text-center mb-4">
                <h3 class="mb-1 fw-bold">LAPORAN BARANG MASUK / KELUAR</h3>
                <p class="text-muted mb-0">Sistem Manajemen Aset & Inventaris</p>
            </div>

            <!-- Informasi Meta Dokumen -->
            <div class="row mb-3" style="font-size: 13px;">
                <div class="col-6">
                    <div><strong>Periode:</strong> @ViewBag.Periode</div>
                    <div><strong>Gudang:</strong> @ViewBag.NamaGudang</div>
                </div>
                <div class="col-6 text-end">
                    <div><strong>Tanggal Cetak:</strong> @DateTime.Now.ToString("dd/MM/yyyy, HH.mm.ss")</div>
                    <div><strong>Tipe Mutasi:</strong> @ViewBag.TipeTransaksi</div>
                </div>
            </div>

            <hr style="border-top: 2px solid #333; opacity: 1;" class="mb-4">

            @if (Model.ListTransaksi == null || !Model.ListTransaksi.Any())
            {
                <div class="text-center py-5 text-muted fst-italic">
                    Tidak ada data transaksi yang ditemukan untuk filter tersebut.
                </div>
            }
            else
            {
                @foreach (var item in Model.ListTransaksi)
                {
                    bool isMasuk = item.TipeTransaksi.ToLower().Contains("in");
                    string badgeColor = isMasuk ? "text-success" : "text-danger";

                    <div class="card-report">
                        <div class="card-report-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <span class="text-dark fw-bold me-2">@item.NoReferensi</span>
                                <span class="text-muted">@item.TanggalWaktu</span>
                            </div>
                            <div>
                                <span class="fw-bold me-3 @badgeColor" style="font-size: 11px;">
                                    @(isMasuk ? "MASUK (STOCK IN)" : "KELUAR (STOCK OUT)")
                                </span>
                                <span class="text-muted" style="font-size: 12px;">Gudang: @item.NamaGudang</span>
                            </div>
                        </div>
                        <div class="p-3">
                            <div class="row mb-3" style="font-size: 12px;">
                                <div class="col-8">
                                    <div><strong>Supplier/Mitra:</strong> @item.SupplierMitra</div>
                                    <div class="mt-1"><strong>Keterangan:</strong> @(string.IsNullOrEmpty(item.Catatan) ? "-" :
                                                                    item.Catatan)</div>
                                    </div>
                                    <div class="col-4 text-end">
                                        <div><strong>Pencatat:</strong> @item.Pencatat</div>
                                    </div>
                                </div>

                                <div class="table-responsive">
                                    <table class="table table-bordered table-sm w-100 mb-0" style="font-size: 12px;">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 15%;">SKU</th>
                                                <th style="width: 35%;">Nama Barang</th>
                                                <th style="width: 15%;">Kuantitas</th>
                                                <th style="width: 20%;">Lokasi Rak</th>
                                                <th style="width: 15%;">Serial Numbers</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (item.Details != null && item.Details.Any())
                                            {
                                                @foreach (var det in item.Details)
                                                {
                                                    <tr>
                                                        <td class="fw-bold">@det.Sku</td>
                                                        <td>@det.NamaProduk</td>
                                                        <td class="fw-bold">@det.Kuantitas</td>
                                                        <td>@det.LokasiRak</td>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(det.SerialNumbers) && det.SerialNumbers != "Non-Serial Number")
                                                            {
                                                                <span class="badge-sn">@det.SerialNumbers</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted fst-italic" style="font-size: 11px;">@det.SerialNumbers</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="5" class="text-center text-muted">Tidak ada rincian barang.</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                }

                <!-- Bagian Tanda Tangan Dokumen -->
                <div class="d-flex justify-content-between signature-section px-4">
                    <div class="text-center">
                        <div>Dilaporkan Oleh,</div>
                        <div class="signature-space"></div>
                        <div class="fw-bold">(_____________________)</div>
                        <div class="fw-bold">Warehouse Staff</div>
                    </div>
                    <div class="text-center">
                        <div>Diketahui Oleh,</div>
                        <div class="signature-space"></div>
                        <div class="fw-bold">(_____________________)</div>
                        <div class="fw-bold">Warehouse Manager</div>
                    </div>
                </div>
            </div>
        </body>
    </html>