<div class="modal fade" id="modalSelesaiAudit" tabindex="-1" aria-labelledby="modalSelesaiAuditLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 540px;">
        <div class="modal-content border-0 shadow-lg p-3 rounded-4" style="background: #ffffff;">
            <div class="modal-body p-3">
                <div class="d-flex align-items-start gap-3">
                    <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                         style="width: 48px; height: 48px; background-color: var(--emerald-light); color: var(--emerald-hover);">
                        <i class="bi bi-question-circle fs-4"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h5 class="fw-bold text-indigo-dark mb-2" id="modalSelesaiAuditLabel" style="color: #0f172a !important; font-size: 1.15rem;">
                            Selesaikan Stock Opname?
                        </h5>
                        <p class="text-muted mb-0 lh-base" style="font-size: 0.925rem; color: #64748b !important;">
                            Apakah Anda yakin ingin menyelesaikan audit stock opname ini? Sistem akan memperbarui posisi stok riil di gudang dan memposting jurnal penyesuaian selisih secara otomatis.
                        </p>
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-4 pt-2">
                    <button type="button" class="btn btn-cancel px-4 py-2 border text-secondary fw-semibold bg-white rounded-3" data-bs-dismiss="modal" style="font-size: 0.875rem;">
                        Batal
                    </button>
                    <!-- Trigger Selesaikan & Sinkronisasi Ajax -->
                    <button type="button" onclick="StockOpname.executeSelesaikanAudit(@Model?.Id)" class="btn btn-emerald px-4 py-2 text-white border-0 rounded-3 fw-semibold shadow-sm" style="background-color: var(--emerald-green) !important; font-size: 0.875rem;">
                        Ya, Selesaikan &amp; Sinkronisasi
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>