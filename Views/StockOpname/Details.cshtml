@model InventoryMultiGudang.ViewModels.StockOpnameFormViewModel
@{
Layout = "_AdminLayout";
}
@Html.AntiForgeryToken()

<style>
  /* 1. Base & Reset Styles */
  html,
  :host {
    -webkit-text-size-adjust: 100%;
    tab-size: 4;
    font-feature-settings: normal;
    font-variation-settings: normal;
    font-family: Figtree, ui-sans-serif, system-ui, sans-serif, Apple Color Emoji, Segoe UI Emoji, Segoe UI Symbol, Noto Color Emoji;
    line-height: 1.5;
  }

  body {
    line-height: inherit;
  }

  *,
  ::before,
  ::after {
    box-sizing: border-box;
    border: 0 solid #e5e7eb;
  }

  /* 2. Layout & Typography Utilities */
  .flex {
    display: flex;
  }

  .block {
    display: block;
  }

  .flex-shrink-0,
  .shrink-0 {
    flex-shrink: 0;
  }

  .items-center {
    align-items: center;
  }

  .gap-1\.5 {
    gap: .375rem;
  }

  .font-sans {
    font-family: Figtree, ui-sans-serif, system-ui, sans-serif;
  }

  .font-bold {
    font-weight: 700;
  }

  .uppercase {
    text-transform: uppercase;
  }

  .tracking-wider {
    letter-spacing: .05em;
  }

  .text-\[10px\] {
    font-size: 10px;
  }

  .text-\[9px\] {
    font-size: 9px;
  }

  /* 3. Spacing & Borders */
  .px-1\.5 {
    padding-left: .375rem;
    padding-right: .375rem;
  }

  .border {
    border-width: 1px;
  }

  .rounded {
    border-radius: .25rem;
  }

  /* 4. Colors & Themes */
  .bg-white {
    background-color: rgb(255 255 255);
  }

  .bg-slate-50 {
    background-color: rgb(248 250 252);
  }

  .border-slate-200 {
    border-color: rgb(226 232 240);
  }

  .text-slate-900 {
    color: rgb(15 23 42);
  }

  .text-blue-700 {
    color: rgb(29 78 216);
  }

  .bg-blue-50 {
    background-color: rgb(239 246 255);
  }

  .text-purple-700 {
    color: rgb(126 34 206);
  }

  .bg-purple-50 {
    background-color: rgb(250 245 255);
  }

  /* Force warna teks menjadi gelap/hitam pada elemen select */
  .formAuditStockOpname select.form-select,
  .formAuditStockOpname select.form-control {
    color: #212529 !important;
    font-weight: 500;
  }

  .formAuditStockOpname select.form-select option,
  .formAuditStockOpname select.form-control option {
    color: #212529 !important;
    background-color: #ffffff !important;
  }
</style>

<div class="container-fluid py-4 px-4" style="max-width: 1400px;">

  <!-- HEADER NAVIGASI & UTAMA -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div class="d-flex align-items-center gap-3">
      <a asp-action="Index" class="btn btn-cancel p-2 d-inline-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
        <i class="bi bi-arrow-left fs-5"></i>
      </a>
      <div>
        <div class="d-flex align-items-center gap-2 mb-1">
          <h1 class="h3 mb-0 fw-bold text-indigo-dark" style="color: #0f172a !important;">@Model.NoReferensi</h1>
        </div>
        <p class="text-muted mb-0 small">Detail hasil penyesuaian audit fisik persediaan barang.</p>
      </div>
    </div>

    <!-- Kelompok Tombol Aksi Kanan -->
    <div class="d-flex flex-wrap gap-2 w-100 w-md-auto justify-content-md-end">
      <!-- Tombol Redirect Print -->
      <a asp-action="Print" asp-route-id="@Model.Id" asp-controller="StockOpname" target="_blank" class="btn btn-success btn-sm rounded-3">
        <i class="bi bi-printer"></i> Cetak Berita Acara
      </a>

      @if (Model.Status == InventoryMultiGudang.Models.StatusOpname.Draft)
      {
      <button data-bs-toggle="modal" data-bs-target="#modalBatalkanAudit" class="btn btn-sm btn-danger">
        <i class="bi bi-x"></i>
        Batalkan
      </button>
      <button data-bs-toggle="modal" data-bs-target="#modalSelesaiAudit" class="btn btn-sm btn-emerald">
        <i class="bi bi-check-lg"></i> Selesaikan Audit
      </button>
      }
      else if (Model.Status == InventoryMultiGudang.Models.StatusOpname.Dibatalkan ||
      Model.Status == InventoryMultiGudang.Models.StatusOpname.Selesai)
      {
      <button data-bs-toggle="modal" id="modalBatalkanAuditHidden" data-bs-target="#modalBatalkanAudit" class="btn btn-sm btn-danger d-none">
        <i class="bi bi-x"></i>
        Batalkan
      </button>
      <button data-bs-toggle="modal" id="modalSelesaiAuditHidden" data-bs-target="#modalSelesaiAudit" class="btn btn-sm btn-emerald d-none">
        <i class="bi bi-check-lg"></i> Selesaikan Audit
      </button>
      }
    </div>
  </div>

  <!-- CARD INFORMASI METADATA UTAMA -->
  <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="background: #ffffff; border: 1px solid var(--border-color) !important;">
    <div class="row g-4 mb-4 border-bottom pb-4" style="border-color: var(--border-color) !important;">
      <div class="col-6 col-md-3">
        <label class="form-label-custom d-block mb-1 text-muted fw-bold tracking-wider" style="font-size: 0.75rem;">NAMA GUDANG</label>
        <span class="fw-bold text-indigo-dark d-block fs-6" style="color: #0f172a !important;">@Model?.NamaGudang</span>
        <span class="text-muted tracking-wider fw-bold" style="font-size: 0.7rem;">@Model?.KodeGudang</span>
      </div>
      <div class="col-6 col-md-3">
        <label class="form-label-custom d-block mb-1 text-muted fw-bold tracking-wider" style="font-size: 0.75rem;">AUDITOR / PEMBUAT</label>
        <span class="fw-bold text-indigo-dark d-block fs-6" style="color: #0f172a !important;">@Model.Auditor</span>
        <span class="text-muted small d-block">Staff Operasional Gudang</span>
      </div>
      <div class="col-6 col-md-3">
        <label class="form-label-custom d-block mb-1 text-muted fw-bold tracking-wider" style="font-size: 0.75rem;">TANGGAL MULAI AUDIT</label>
        <span class="fw-semibold text-indigo-dark d-block fs-6" style="color: #0f172a !important;">@Model.TanggalMulai.ToString("dd MMM yyyy, HH.mm")</span>
      </div>
      <div class="col-6 col-md-3">
        <label class="form-label-custom d-block mb-1 text-muted fw-bold tracking-wider" style="font-size: 0.75rem;">STATUS DOKUMEN</label>
        <span class="badge bg-success rounded px-2.5 py-0.5 text-xs fw-bold d-inline-flex align-items-center gap-1">@Model.Status</span>
        <span class="fw-semibold text-indigo-dark d-block fs-6" style="color: #0f172a !important;">
          @(Model?.TanggalSelesai?.ToString("dd MMM yyyy, HH.mm") ?? "-")
        </span>
      </div>
    </div>

    <div class="row">
      <div class="col-12">
        <label class="form-label-custom d-block mb-1 text-muted fw-bold tracking-wider" style="font-size: 0.75rem;">CATATAN DOKUMEN</label>
        <p class="mb-0 text-indigo-dark fw-medium" style="color: #0f172a !important;">@(string.IsNullOrEmpty(Model.Catatan) ? "-" : Model.Catatan)</p>
      </div>
    </div>
  </div>

  <!-- AREA PENCOCOKAN STOK FISIK PRODUK -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="bg-light-subtle px-4 py-3 border-bottom d-flex align-items-center gap-2">
      <i class="bi bi-layers text-muted"></i>
      <span class="text-muted tracking-wider fw-bold text-uppercase" style="font-size: 0.75rem;">Pencocokan Stok Fisik
        Produk (TOTAL: @Model.Items.Count)</span>
    </div>

    <div class="p-4">
      @if (Model.Items != null && Model.Items.Count > 0)
      {
      @foreach (var item in Model.Items)
      {
      <div class="card border-0 shadow-sm rounded-4 p-4 audit-item-row mb-3" style="background: #ffffff; border: 1px solid var(--border-color) !important;">
        <input type="hidden" class="produk-id" value="@item.ProdukId" />

        <div class="row align-items-center g-4">
          <!-- INFO PRODUK -->
          <div class="col-12 col-md-6">
            <h5 class="fw-bold text-indigo-dark mb-2" style="color: #0f172a !important; font-size: 1.1rem;">
              @item.NamaProduk</h5>
            <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
              <span class="text-muted tracking-wider fw-bold small me-2 sku font-monospace" style="font-size: 0.75rem;">@item.Sku</span>
              <span class="badge bg-secondary-subtle text-secondary fw-bold text-uppercase px-2 py-0.5 rounded" style="font-size: 0.6rem;">@item.TipeBarang</span>
              @if (item.SnItems != null && item.SnItems.Count > 0)
              {
              <span class="badge bg-secondary-subtle text-secondary fw-bold text-uppercase px-2 py-0.5 rounded" style="font-size: 0.6rem;">SN Tracked</span>
              }
              else
              {
              <span class="badge bg-secondary-subtle text-secondary fw-bold text-uppercase px-2 py-0.5 rounded" style="font-size: 0.6rem;">Non-SN (Bulk)</span>
              }
            </div>
          </div>

          <!-- Statistik Stok (Sistem, Fisik, Selisih) -->
          <div class="col-12 col-md-6">
            <div class="row text-center g-2 bg-light p-3 rounded-3 align-items-center">
              <div class="col-4 border-end">
                <span class="text-muted tracking-wider fw-bold text-uppercase d-block mb-1" style="font-size: 0.65rem;">Stok Sistem</span>
                <span class="fw-bold text-indigo-dark fs-6 stok-sistem">@item.StokSistem</span>
              </div>
              <div class="col-4 border-end">
                <span class="text-muted tracking-wider fw-bold text-uppercase d-block mb-1" style="font-size: 0.65rem;">Stok Fisik</span>
                @if (item.SnItems != null && item.SnItems.Count > 0)
                {
                <span class="fw-bold text-indigo-dark fs-6 stok-fisik-input">@item.StokFisik</span>

                }
                else
                {
                <input type="number" name="Items[@Model.Items.IndexOf(item)].StokFisik" class="form-control form-control-sm text-center fw-bold stok-fisik-manual" value="@item.StokFisik" min="0" />
                }
              </div>
              <div class="col-4">
                <span class="text-muted tracking-wider fw-bold text-uppercase d-block mb-1" style="font-size: 0.65rem;">Selisih</span>
                <!-- Sinkronisasi kelas warna merah otomatis jika selisih != 0 -->
                <span class="fw-bold fs-6 selisih-val @(item.Selisih != 0 ? " text-danger" : "text-muted" )">
                  @item.Selisih
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- VERIFIKASI KONDISI NOMOR SERI (SN) -->
        @if (item.SnItems != null && item.SnItems.Count > 0)
        {
        <div class="card bg-light border-0 mt-3 p-3 rounded-3">
          <div class="card-body p-0">
            <h6 class="text-[10px] fw-bold text-secondary uppercase tracking-wider d-flex align-items-center gap-1.5 mb-3">
              <i class="bi bi-tag-fill text-primary"></i> Verifikasi Kondisi Nomor Seri (SN) Aset & Alasan Selisih
            </h6>
            <div class="row g-3">
              @foreach (var sn in item.SnItems)
              {
              var badgeClass = sn.Kondisi switch
              {
              "Ditemukan (OK)" => "bg-success text-white",
              "Hilang (Lost)" => "bg-danger text-white",
              "Rusak (Damage)" => "bg-warning text-dark",
              "Dihapuskan (Disposed)" => "bg-secondary text-white",
              _ => "bg-secondary text-white"
              };

              <div class="col-12 col-md-6">
                <div class="p-3 bg-white border rounded-2">
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <div>
                      <span class="fw-bold small text-secondary d-block">@sn.SerialNumber</span>                      
                    </div>
                    <select class="@badgeClass form-select form-select-sm sn-select-item" data-sn="@sn.SerialNumber" data-produkitemid="@sn.ProdukItemId" style="width: 140px; font-size: 0.75rem;" disabled>
                    <option value="Ditemukan (OK)" selected="@(sn.Kondisi == "Ditemukan (OK)" ? "selected" : null)">Ditemukan (OK)</option>
                    <option value="Hilang (Lost)" selected="@(sn.Kondisi == "Hilang (Lost)" ? "selected" : null)">Hilang (Lost)</option>
                    <option value="Rusak (Damage)" selected="@(sn.Kondisi == "Rusak (Damage)" ? "selected" : null)">Rusak (Damage)</option>
                    <option value="Dihapuskan (Disposed)" selected="@(sn.Kondisi == "Dihapuskan (Disposed)" ? "selected" : null)">Dihapuskan (Disposed)</option>
                  </select>
                  </div>
                  <!-- Input Alasan & Keterangan khusus melekat per SN item -->
                  <div class="row g-2 mt-1">
                    <div class="col-6">
                      <input type="text" class="form-control form-control-sm sn-alasan" value="@sn.AlasanSelisih" placeholder="Alasan (jika hilang/rusak)..." style="font-size: 0.7rem;" />
                    </div>
                    <div class="col-6">
                      <input type="text" class="form-control form-control-sm sn-keterangan" value="@sn.Keterangan" placeholder="Keterangan..." style="font-size: 0.7rem;" />
                    </div>
                  </div>
                </div>
              </div>
              }
            </div>
          </div>
        </div>
        }
        else
        {
        <!-- Input Alasan & Keterangan khusus untuk Produk Non-SN -->
        <div class="row mt-3 pt-3 border-top g-3">
          <div class="col-12 col-md-6">
            <label class="form-label text-muted fw-bold tracking-wider mb-1" style="font-size: 0.7rem;">ALASAN
              SELISIH:</label>
            <input type="text" class="form-control form-control-sm alasan-selisih-input" value="@item.AlasanSelisih" placeholder="Contoh: Selisih opname fisik..." />
          </div>
          <div class="col-12 col-md-6">
            <label class="form-label text-muted fw-bold tracking-wider mb-1" style="font-size: 0.7rem;">KETERANGAN:</label>
            <input type="text" class="form-control form-control-sm keterangan-input" value="@item.Keterangan" placeholder="Keterangan tambahan..." />
          </div>
        </div>
        }
      </div>
      }
      }
    </div>
  </div>
</div>

@await Html.PartialAsync("modalSelesaiAudit")
@await Html.PartialAsync("modalBatalkanAudit")

@section Scripts {
<script src="~/js/StockOpname.js"></script>
<script>
  $(document).ready(function() {
    $('.sn-select-item').each(function() {
      updateSelectColor(this);
    });
    $('.audit-item-row').each(function() {
      hitungStokFisikOtomatisBaris($(this));
    });
  });
  $(document).on('input change', '.stok-fisik-manual', function() {
    var $row = $(this).closest('.audit-item-row');
    hitungStokFisikOtomatisBaris($row);
  });

  function hitungStokFisikOtomatisBaris($row) {
    var stokSistem = parseInt($row.find('.stok-sistem').text().trim()) || 0;
    var totalItemSn = $row.find('.sn-select-item').length;
    var stokFisikAktual = 0;
    if (totalItemSn > 0) {
      $row.find('.sn-select-item').each(function() {
        if ($(this).val() !== "Hilang (Lost)") {
          stokFisikAktual += 1;
        }
      });
      $row.find('.stok-fisik-input').text(stokFisikAktual);
    } else {
      stokFisikAktual = parseInt($row.find('.stok-fisik-manual').val()) || 0;
    }
    var selisih = stokFisikAktual - stokSistem;
    var $selisihVal = $row.find('.selisih-val');
    var selisihFormatted = selisih > 0 ? "+" + selisih : selisih;
    $selisihVal.text(selisihFormatted);
    $selisihVal.removeClass('text-success text-danger text-muted');
    if (selisih < 0) {
      $selisihVal.addClass('text-danger');
    } else if (selisih > 0) {
      $selisihVal.addClass('text-success');
    } else {
      $selisihVal.addClass('text-muted');
    }
  }
  $(document).on('change', '.sn-select-item', function() {
    updateSelectColor(this);
    var $row = $(this).closest('.audit-item-row');
    hitungStokFisikOtomatisBaris($row);
  });

  function updateSelectColor(selectElement) {
    if (!selectElement) return;
    var val = $(selectElement).val() ? $(selectElement).val().trim() : "";
    $(selectElement).removeClass('bg-success bg-danger bg-warning bg-secondary text-white text-dark');
    switch (val) {
      case "Ditemukan (OK)":
        $(selectElement).addClass('bg-success text-white');
        break;
      case "Hilang (Lost)":
        $(selectElement).addClass('bg-danger text-white');
        break;
      case "Rusak (Damage)":
        $(selectElement).addClass('bg-warning text-dark');
        break;
      case "Dihapuskan (Disposed)":
        $(selectElement).addClass('bg-secondary text-white');
        break;
      default:
        $(selectElement).addClass('bg-secondary text-white');
        break;
    }
  }
</script>
}