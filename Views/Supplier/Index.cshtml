@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manajemen Supplier";
}
<style>
.form-control, 
.form-select, 
.form-input-custom,
.form-control-custom {
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 0.6rem 0.9rem;
    font-size: 0.95rem;
    color: #1e293b !important;
    font-weight: 500;
    transition: all 0.2s ease;
}
</style>
<div class="container-fluid">

    <!-- HEADER SECTION -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold text-indigo-dark mb-1">Manajemen Supplier</h1>
            <p class="text-muted small mb-0">Kelola data pemasok barang, info kontak, alamat, dan person-in-charge (PIC) logistik.</p>
        </div>
        <div>
            <button class="btn btn-success rounded-pill px-4 btn-sm" data-bs-toggle="modal" data-bs-target="#modalTambahSupplier">
                <i class="bi bi-plus-lg"></i> Tambah Supplier
            </button>
        </div>
    </div>

    <!-- FILTER & SEARCH BAR -->
    <div class="card border-0 shadow-sm p-3 mb-4" style="border-radius: 12px;">
        <div class="row g-3 align-items-center justify-content-between">
            <div class="col-12 col-md-4">
                <div class="input-group">
                    <span class="input-group-text border-end-0 bg-white text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="searchInput" class="form-control border-start-0 ps-0" placeholder="Cari kode, nama supplier, atau PIC...">
                </div>
            </div>
            <div class="col-12 col-md-auto d-flex align-items-center gap-2 justify-content-md-end">
                <span class="text-muted small fw-bold text-uppercase tracking-wider" style="font-size: 0.75rem;">Status:</span>
                <select id="statusFilter" class="form-select text-muted fw-medium py-1.5" style="min-width: 150px;">
                    <option value="">Semua Status</option>
                    <option value="true">Aktif</option>
                    <option value="false">Non-Aktif</option>
                </select>
            </div>
        </div>
    </div>

    <!-- TABLE AREA -->
    <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 12px;">
        <div class="table-responsive">
            <table class="table align-middle mb-0 text-nowrap">
                <thead class="bg-light border-bottom">
                    <tr class="text-uppercase text-muted fw-bold" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                        <th class="ps-4 py-3" style="width: 35%;">Supplier Info</th>
                        <th class="py-3" style="width: 25%;">Hubungan Kontak</th>
                        <th class="py-3" style="width: 20%;">Person In Charge (PIC)</th>
                        <th class="py-3 text-center" style="width: 10%;">Status</th>
                        <th class="py-3 text-center pe-4" style="width: 10%;">Aksi</th>
                    </tr>
                </thead>
                <tbody id="supplierTableBody">
                    <!-- Loaded via AJAX -->
                </tbody>
            </table>
        </div>
        
        <!-- PAGINATION AREA -->
        <div class="card-footer bg-white border-0 py-3 d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 w-100">
            <div class="text-muted small" id="paginationInfo">Menampilkan 0 data</div>

            <!-- ms-auto akan mendorong elemen navigasi pagination ke sisi kanan -->
            <nav aria-label="Page navigation" class="ms-auto">
                <ul class="pagination pagination-sm mb-0" id="paginationContainer"></ul>
            </nav>
        </div>
    </div>
</div>

@await Html.PartialAsync("Create")
@await Html.PartialAsync("Edit")
@await Html.PartialAsync("Delete")

@section Scripts {
    <script src="~/js/supplier.js"></script>
}