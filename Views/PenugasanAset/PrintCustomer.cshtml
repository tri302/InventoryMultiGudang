@model InventoryMultiGudang.ViewModels.PenugasanAsetPrintCustomerViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cetak Berita Acara - @Model.KodePenugasan</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
            color: #1e293b;
            font-size: 0.85rem;
        }

        .print-container {
            max-width: 850px;
            margin: 20px auto;
            background: #fff;
            padding: 40px 50px;
            border-radius: 8px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        .border-thick {
            border-bottom: 2px solid #000;
        }

        .card-info {
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 16px 20px;
            background-color: #ffffff;
            height: 100%;
        }

        .table-report th {
            background-color: #f8fafc;
            color: #64748b;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 10px 12px;
            border-bottom: 1px solid #e2e8f0;
        }

        .table-report td {
            padding: 12px;
            vertical-align: middle;
            border-bottom: 1px solid #f1f5f9;
        }

        .badge-cond {
            font-size: 0.65rem;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 4px;
            text-transform: uppercase;
        }

        .note-box {
            border-left: 3px solid #ef4444;
            background-color: #fef2f2;
            padding: 12px 16px;
            border-radius: 0 8px 8px 0;
        }

        @@media print {
            .no-print {
                display: none !important;
            }

            body {
                background-color: #fff;
            }

            .print-container {
                max-width: 100%;
                margin: 0;
                padding: 0;
                border: none;
                box-shadow: none;
            }
        }
    </style>
</head>
<body>
    <div class="no-print bg-white border-bottom py-2 px-4 d-flex justify-content-between align-items-center sticky-top shadow-sm">
        <div class="d-flex align-items-center gap-2">
            <div class="avatar-box bg-light text-danger d-flex align-items-center justify-content-center rounded" style="width: 36px; height: 36px;">
                <i class="bi bi-file-earmark-pdf-fill fs-5"></i>
            </div>
            <div>
                <h6 class="mb-0 fw-bold">Pratinjau Cetak Berita Acara</h6>
                <small class="text-muted">Gunakan tombol cetak untuk mencetak atau menyimpan sebagai PDF.</small>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button onclick="window.close()" class="btn btn-secondary btn-sm rounded-3"><i class="bi bi-x-lg"></i> Tutup Halaman</button>
            <button onclick="window.print()" class="btn btn-success btn-sm rounded-3"><i class="bi bi-printer"></i> Cetak Sekarang</button>
        </div>
    </div>

    <div class="print-container">
        <!-- KOP DOKUMEN -->
        <div class="d-flex justify-content-between align-items-start pb-3 mb-3 border-thick">
            <div>
                <h3 class="fw-extrabold text-dark mb-1" style="font-weight: 900; letter-spacing: -0.5px;">@Model.PerusahaanNama</h3>
                <p class="text-muted fw-bold mb-2" style="font-size: 8.5px; line-height: 1.3; letter-spacing: 0.3px; max-width: 420px; text-transform: uppercase;">
                    @Model.PerusahaanSlogan
                </p>
                <p class="text-muted mb-0" style="font-size: 11px; line-height: 1.4;">
                    @Model.PerusahaanAlamat<br>
                    Telp: @Model.PerusahaanTelp | Email: @Model.PerusahaanEmail
                </p>
            </div>
            <div class="text-end">
                <div class="qr-code mb-1">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=90x90&data=@Model.KodePenugasan" alt="QR Code" style="width: 85px; height: 85px;" />
                </div>
                <div class="border border-dark px-2 py-0.5 rounded-1 d-inline-block font-monospace fw-bold" style="font-size: 10px;">
                    @Model.KodePenugasan
                </div>
            </div>
        </div>

        <div class="text-center my-4">
            <h5 class="fw-bold text-uppercase mb-1 text-decoration-underline" style="letter-spacing: 0.5px;">BERITA ACARA SERAH TERIMA ASET</h5>
            <div class="text-muted small">Nomor Dokumen: <span class="font-monospace fw-semibold text-dark">@Model.KodePenugasan</span></div>
        </div>

        <p class="text-secondary small mb-4" style="line-height: 1.6; font-size: 0.82rem;">
            Pada hari ini, <strong>@Model.TanggalSerahTerima.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("id-ID"))</strong>, bertempat di kantor <strong>@Model.PerusahaanNama</strong>, telah diserahterimakan sejumlah barang/aset inventaris kepada penerima di bawah ini untuk digunakan sebagai fasilitas operasional perusahaan.
        </p>

        <div class="row g-3 mb-4">
            <div class="col-6">
                <div class="card-info">
                    <div class="text-uppercase text-muted fw-bold mb-2" style="font-size: 9px; letter-spacing: 0.5px;">PIHAK PENERIMA (RECEIVER)</div>
                    <h6 class="fw-bold text-dark mb-1">@Model.CustomerNama</h6>
                    <div class="text-muted small mb-2" style="font-size: 11px;">Kode Customer: <span class="font-monospace">@Model.CustomerKode</span></div>
                    <div class="text-muted small" style="font-size: 11px; line-height: 1.3;">
                        Alamat: @Model.CustomerAlamat
                    </div>
                </div>
            </div>

            <div class="col-6">
                <div class="card-info">
                    <div class="text-uppercase text-muted fw-bold mb-2" style="font-size: 9px; letter-spacing: 0.5px;">INFORMASI DOKUMEN</div>
                    <div class="d-flex justify-content-between mb-1 small">
                        <span class="text-muted" style="font-size: 11px;">Tanggal Serah:</span>
                        <span class="fw-semibold text-dark" style="font-size: 11px;">@Model.TanggalSerahTerima.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("id-ID"))</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1 small">
                        <span class="text-muted" style="font-size: 11px;">Status Dokumen:</span>
                        <span class="fw-bold @(Model.Status switch
                    {
                    InventoryMultiGudang.Models.StatusPenugasan.MenungguPersetujuan => " badge bg-warning text-dark border-danger px-2 py-1", InventoryMultiGudang.Models.StatusPenugasan.DalamPenugasan=> "badge bg-success text-white border-danger px-2 py-1",
                    InventoryMultiGudang.Models.StatusPenugasan.Dikembalikan => "badge bg-success text-dark border-danger px-2 py-1",
                    InventoryMultiGudang.Models.StatusPenugasan.Ditolak => "badge bg-danger text-dark border-danger px-2 py-1",
                    InventoryMultiGudang.Models.StatusPenugasan.TransferAsetLangsung => "badge bg-primary text-dark border-danger px-2 py-1",
                    _ => "text-muted"
                    })" style="font-size: 11px;">
                    @(Model.Status switch
                    {
                    InventoryMultiGudang.Models.StatusPenugasan.MenungguPersetujuan => "Menunggu Persetujuan",
                    InventoryMultiGudang.Models.StatusPenugasan.DalamPenugasan => "Assigned (Aktif)",
                    InventoryMultiGudang.Models.StatusPenugasan.Dikembalikan => "Dikembalikan",
                    InventoryMultiGudang.Models.StatusPenugasan.Ditolak => "Ditolak",
                    InventoryMultiGudang.Models.StatusPenugasan.TransferAsetLangsung => "Transfer Aset Langsung",
                    _ => "-"
                    })
                </span>
                    </div>
                    <div class="d-flex justify-content-between small">
                        <span class="text-muted" style="font-size: 11px;">Penyerah (Admin):</span>
                        <span class="fw-semibold text-dark" style="font-size: 11px;">@Model.AdminPenyerah</span>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Keterangan))
        {
            <div class="note-box mb-4">
                <div class="text-muted fw-bold mb-1" style="font-size: 11px;">Catatan/Keterangan:</div>
                <div class="fst-italic text-dark small" style="font-size: 0.82rem;">"@Model.Keterangan"</div>
            </div>
        }

        <div class="mb-4">
            <div class="text-uppercase fw-bold text-dark mb-2" style="font-size: 10px; letter-spacing: 0.5px;">DAFTAR BARANG YANG DISERAHKAN</div>
            <table class="table table-report align-middle mb-0">
                <thead>
                    <tr>
                        <th width="5%" class="text-center">NO</th>
                        <th width="20%">SKU & MEREK</th>
                        <th width="30%">NAMA BARANG</th>
                        <th width="22%">GUDANG & LOKASI</th>
                        <th width="23%">NOMOR SERI (SN)</th>
                        <th width="10%" class="text-center">KONDISI SERAH</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Details != null && Model.Details.Any())
                    {
                        int no = 1;
                        foreach (var item in Model.Details)
                        {
                            <tr>
                                <td class="text-center text-muted fw-semibold" style="font-size: 11px;">@(no++)</td>
                                <td>
                                    <div class="fw-bold font-monospace text-dark" style="font-size: 11px;">@item.Sku</div>
                                    <div class="text-muted" style="font-size: 10px;">@(!string.IsNullOrEmpty(item.Merek) ? item.Merek : "-")</div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark" style="font-size: 11px;">@item.NamaBarang</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark" style="font-size: 11px;">@item.GudangNama</div>
                                    <div class="text-muted" style="font-size: 10px;">@item.LokasiRak</div>
                                </td>
                                <td>
                                    <div class="font-monospace fw-bold text-dark" style="font-size: 10px;">@item.SerialNumber</div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border badge-cond">@item.KondisiSerah</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="text-center py-3 text-muted">Tidak ada daftar barang.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <p class="text-secondary small mb-5" style="line-height: 1.5; font-size: 0.78rem;">
            Demikian berita acara serah terima aset ini dibuat secara sadar, tanpa paksaan, dan untuk dapat dipergunakan sebagaimana mestinya. Penerima berkewajiban merawat, menjaga, dan melaporkan jika terjadi kerusakan atau kehilangan pada aset tersebut.
        </p>

        <div class="row text-center mt-5 pt-3">
            <div class="col-6">
                <div class="text-uppercase text-muted fw-bold mb-1" style="font-size: 9px; letter-spacing: 0.5px;">PIHAK PENYERAH (ISSUER)</div>
                <div class="fw-bold text-dark mb-5" style="font-size: 12px;">@Model.PerusahaanNama</div>
                <div class="fw-bold text-dark pt-3" style="font-size: 11px;">@Model.AdminPenyerah</div>
                <div class="text-muted" style="font-size: 10px;">Staff Logistik/Inventory</div>
            </div>
            <div class="col-6">
                <div class="text-uppercase text-muted fw-bold mb-1" style="font-size: 9px; letter-spacing: 0.5px;">PIHAK PENERIMA (RECEIVER)</div>
                <div class="fw-bold text-dark mb-5" style="font-size: 12px;">Customer: @Model.CustomerNama</div>
                <div class="fw-bold text-dark pt-3" style="font-size: 11px;">Perwakilan Customer</div>
                <div class="text-muted" style="font-size: 10px;">Kode Customer: @Model.CustomerKode</div>
            </div>
        </div>
    </div>
</body>
</html>