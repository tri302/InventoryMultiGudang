@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manajemen Rak";
}
@Html.AntiForgeryToken()

<div class="container-fluid px-0">
    <!-- TOP BAR -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1 text-indigo-dark fw-bold">Kelola Raks</h1>
            <p class="text-muted small mb-0">Atur Rak, Area, dan Bin Location untuk memudahkan penempatan barang.</p>
        </div>
        <button class="btn btn-success rounded-pill px-4 btn-sm" data-bs-toggle="modal" data-bs-target="#modalTambahRak" onclick="resetFormCreate()">
            <i class="bi bi-plus"></i>Tambah Rak
        </button>
    </div>

    <!-- GRID CONTAINER -->
    <div class="row g-3" id="rakGridContainer">
        <!-- Content loaded via AJAX -->
    </div>

    <!-- PAGINATION CONTAINER -->
    <div class="d-flex justify-content-end mt-4" id="paginationContainer">
        <!-- Pagination loaded via AJAX -->
    </div>
</div>

@await Html.PartialAsync("Create")
@await Html.PartialAsync("Edit")
@await Html.PartialAsync("Delete")

@section Scripts {    
    <script src="~/js/rak.js"></script>
}