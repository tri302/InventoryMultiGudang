<div class="modal fade" id="modalEditRak" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modalEditRakLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-box-seam text-primary fs-4"></i>
                    <h5 class="form-title-custom mb-4">Edit Lokasi Rak</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Body -->
            <div class="modal-body">
                <div class="form-container-custom">
                    <form id="formEditRak" onsubmit="submitEditRak(event)">                        
                        <div class="mb-3">
                            <label class="form-label-custom">PILIH GUDANG <span class="text-danger">*</span></label>
                            <select id="editGudangId" class="form-select form-input-custom select2-gudang" required>
                                <!-- Data diisi secara AJAX -->
                            </select>
                        </div>
                        <input type="hidden" id="editId" />
                        <!-- BARIS 3 KOLOM (AREA, NAMA RAK, BIN NO) -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label-custom">AREA / ZONE</label>
                                <input type="text" id="editArea" class="form-control form-input-custom" placeholder="A" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label-custom">NAMA RAK</label>
                                <input type="text" id="editNamaRak" class="form-control form-input-custom" placeholder="Rak 01" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label-custom">BIN NO</label>
                                <input type="text" id="editBinNo" class="form-control form-input-custom" placeholder="01" required>
                            </div>
                        </div>

                        <!-- KODE LOKASI (UNIK) -->
                        <div class="mb-3">
                            <label class="form-label-custom">KODE LOKASI (UNIK)</label>
                            <input type="text" id="editKodeLokasi" class="form-control form-input-custom font-monospace fw-bold text-indigo" placeholder="e.g. A-01-01" required>
                            <div class="form-hint-custom mt-2">
                                <i class="bi bi-info-circle-fill me-1"></i> Sistem menyarankan format kode lokasi [Area]-[Rak]-[Bin]
                            </div>
                        </div>

                        <!-- DESKRIPSI / CATATAN LOKASI -->
                        <div class="mb-4">
                            <label class="form-label-custom">DESKRIPSI / CATATAN LOKASI</label>
                            <textarea id="editDeskripsi" class="form-control form-input-custom" rows="3" placeholder="Keterangan isi barang, garansi khusus, dll..."></textarea>
                        </div>

                        <!-- CHECKBOX LOKASI AKTIF -->
                        <div class="mb-4">
                            <div class="form-check form-check-custom">
                                <input class="form-check-input form-checkbox-custom" type="checkbox" id="editCheckLokasiAktif">
                                <label class="form-check-label fw-semibold ms-1" for="editCheckLokasiAktif">
                                    Lokasi Aktif
                                </label>
                            </div>
                        </div>

                        <!-- TOMBOL AKSI -->
                        <div class="d-flex justify-content-center gap-2 pt-3 border-top border-light-subtle">
                            <button type="button" data-bs-dismiss="modal" class="btn btn-batal-custom px-4 btn-sm">
                                <i class="bi bi-arrow-90deg-left"></i> Batal
                            </button>
                            <button type="submit" class="btn btn-emerald-custom px-4 btn-sm">
                                <i class="bi bi-check-lg me-1"></i> Simpan Perubahan
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>