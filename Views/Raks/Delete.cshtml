<div class="modal fade" id="modalHapusGudang" tabindex="-1" aria-labelledby="modalHapusGudangLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm-custom">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-body text-center p-4 pt-5">
                <input type="hidden" id="deleteId" />
                <!-- Ikon Tempat Sampah -->
                <div class="icon-delete-wrapper mb-4">
                    <i class="bi bi-trash3-fill"></i>
                </div>

                <!-- Judul -->
                <h3 class="modal-title-custom mb-3" id="modalHapusGudangLabel">Hapus Rak Gudang</h3>

                <!-- Teks Deskripsi -->
                <p class="modal-text-custom mb-4">
                    Apakah Anda yakin ingin menghapus Rak gudang <strong class="text-dark" id="deleteTargetName">-</strong>? Tindakan ini tidak dapat dibatalkan.
                </p>

                <!-- Tombol Aksi -->
                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-sm btn-batal-modal px-4 py-2" data-bs-dismiss="modal">Batal</button>
                    <button type="button" class="btn btn-sm btn-delete-modal px-4 py-2" onclick="confirmDeleteRak()">Ya, Hapus</button>
                </div>
            </div>
        </div>
    </div>
</div>