@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Master Kategori";
}

@Html.AntiForgeryToken()

<div class="container-fluid">
    <!-- Header Page -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-indigo-dark mb-1">Master Kategori</h1>
            <p class="text-muted small mb-0">Kelola kategori produk dan klasifikasi inventaris.</p>
        </div>
        <div>
            <button class="btn btn-success rounded-pill px-4 btn-sm" data-bs-toggle="modal" data-bs-target="#modalTambahKategori">
                <i class="bi bi-plus-lg me-1"></i> Tambah Kategori
            </button>
        </div>
    </div>

    <!-- Filter & Search -->
    <div class="card border-0 shadow-sm p-3 mb-4" style="border-radius: 12px;">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-4">
                <div class="input-group">
                    <span class="input-group-text border-end-0 bg-white text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="filterSearchKategori" class="form-control border-start-0 ps-0" placeholder="Cari nama atau deskripsi kategori...">
                </div>
            </div>
            <div class="col-12 col-md d-flex justify-content-md-end align-items-center">
                <span class="text-muted small fw-medium">Total Kategori: <strong id="totalKategoriCount" class="text-indigo-dark fs-6">0</strong></span>
            </div>
        </div>
    </div>

    <!-- Table Section -->
    <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 12px;">
        <div class="table-responsive">
            <table class="table align-middle mb-0 text-nowrap">
                <thead class="bg-light border-bottom">
                    <tr class="text-uppercase text-muted fw-bold" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                        <th class="ps-4 py-3" style="width: 5%;">#</th>
                        <th class="py-3" style="width: 35%;">Nama Kategori</th>
                        <th class="py-3" style="width: 45%;">Deskripsi</th>
                        <th class="py-3 text-center pe-4" style="width: 15%;">Aksi</th>
                    </tr>
                </thead>
                <tbody id="kategoriTableBody">
                    <!-- Data AJAX Render Here -->
                </tbody>
            </table>
        </div>

        <!-- Pagination Bar -->
        <div class="d-flex justify-content-between align-items-center p-3 border-top" id="paginationContainerKategori">
            <div class="text-muted small" id="paginationInfoKategori">Menampilkan 0 data</div>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0" id="paginationNavKategori"></ul>
            </nav>
        </div>
    </div>
</div>

<!-- Modal Partials -->
@await Html.PartialAsync("Create", new InventoryMultiGudang.ViewModels.KategoriViewModel())
@await Html.PartialAsync("Edit", new InventoryMultiGudang.ViewModels.KategoriViewModel())
@await Html.PartialAsync("Delete")

@section Scripts {
    <script src="~/js/kategori.js"></script>
}