@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manajemen Customer";
}
<style>
    .form-control, 
    .form-select, 
    .form-input-custom,
    .form-control-custom {
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 0.6rem 0.9rem;
        font-size: 0.95rem;
        color: #1e293b !important;
        font-weight: 500;
        transition: all 0.2s ease;
    }
</style>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

<input type="hidden" id="__RequestVerificationToken" value="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />

<div class="container-fluid">

    <!-- HEADER SECTION -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold text-indigo-dark mb-1">Manajemen Customer</h1>
            <p class="text-muted small mb-0">Kelola data customer eksternal, info kontak, alamat site, dan riwayat penugasan unit leasing.</p>
        </div>
        <div>
            <button class="btn btn-success rounded-pill px-4 btn-sm" data-bs-toggle="modal" data-bs-target="#modalTambahCustomer" onclick="resetFormCreate()">
                <i class="bi bi-plus-lg"></i> Tambah Customer
            </button>
        </div>
    </div>

    <!-- FILTER & SEARCH BAR -->
    <div class="card border-0 shadow-sm p-3 mb-4" style="border-radius: 12px;">
        <div class="row g-3 align-items-center justify-content-between">
            <div class="col-12 col-md-4">
                <div class="input-group">
                    <span class="input-group-text border-end-0 bg-white text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="txtSearch" class="form-control border-start-0 ps-0" placeholder="Cari kode customer, nama, email...">
                </div>
            </div>
            <div class="col-12 col-md-auto d-flex align-items-center gap-2 justify-content-md-end">
                <span class="text-muted small fw-bold text-uppercase tracking-wider" style="font-size: 0.75rem;">Status:</span>
                <select id="selectStatus" class="form-select text-muted fw-medium py-1.5" style="min-width: 150px;">
                    <option selected>Semua Status</option>
                    <option>Aktif</option>
                    <option>Non-Aktif</option>
                </select>
            </div>
        </div>
    </div>

    <!-- TABLE AREA CONTAINING AJAX PARTIAL VIEW -->
    <div id="customerTableContainer">
        <!-- Live Table Content loaded via AJAX -->
    </div>
</div>

@await Html.PartialAsync("Create", new InventoryMultiGudang.ViewModels.CustomerViewModel())
@await Html.PartialAsync("Edit", new InventoryMultiGudang.ViewModels.CustomerViewModel())
@await Html.PartialAsync("Delete")

@section Scripts {    
    <script src="~/js/customer.js"></script>
}