<!-- Modal Konfirmasi Hapus -->
<div class="modal fade" id="modalHapusCustomer" tabindex="-1" aria-labelledby="modalHapusCustomerLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm-custom">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-body text-center p-4 pt-5">
                <input type="hidden" id="Delete_Id" />
                <!-- Ikon Tempat Sampah -->
                <div class="icon-delete-wrapper mb-4">
                    <i class="bi bi-trash3-fill"></i>
                </div>

                <!-- Judul -->
                <h3 class="modal-title-custom mb-3" id="modalHapusCustomerLabel">Hapus Customer</h3>

                <!-- Teks Deskripsi -->
