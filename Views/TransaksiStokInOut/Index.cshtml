@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manajemen Transaksi Pergerakan Stok";
}
<style>
.form-control, 
.form-select, 
.form-input-custom,
.form-control-custom {
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 0.6rem 0.9rem;
    font-size: 0.95rem;
    color: #1e293b !important;
    font-weight: 500;
    transition: all 0.2s ease;
}
</style>
<div class="container-fluid">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-indigo-dark mb-1">Transaksi Pergerakan Stok</h1>
            <p class="text-muted small mb-0">Daftar riwayat mutasi penambahan (Inbound) dan pengurangan (Outbound) stok barang secara massal.</p>
        </div>
        <a asp-action="StokIn" asp-controller="TransaksiStokInOut" class="btn btn-success rounded-pill px-4 btn-sm">
            <i class="bi bi-plus-lg"></i> Tambah Transaksi
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="row align-items-center g-3">
                <div class="col-12 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="searchInput" class="form-control border-start-0 ps-0" placeholder="Cari referensi, catatan, produk...">
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <select id="filterGudang" class="form-select select2-gudang" data-placeholder="Semua Gudang">
                        <option value=""></option>
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <select id="filterTipe" class="form-select">
                        <option value="">Semua Tipe</option>
                        <option value="Stock Out">Stock Out</option>
                        <option value="Stock In">Stock In</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 text-md-end text-muted small fw-semibold">
                    Total Transaksi: <span id="totalCountBadge" class="text-indigo-dark fs-6 fw-bold">0</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0" style="min-width: 1000px;">
                <thead>
                    <tr class="text-uppercase small fw-bold tracking-wider text-muted border-bottom">
                        <th class="py-3 px-4">Nomor Referensi</th>
                        <th class="py-3">Gudang Target</th>
                        <th class="py-3 text-center">Tipe Transaksi</th>
                        <th class="py-3">Jumlah Barang</th>
                        <th class="py-3">Pembuat</th>
                        <th class="py-3">Tanggal Posting</th>
                        <th class="py-3 text-center">Aksi</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white border-0 py-3">
            <div class="d-flex justify-content-between align-items-center">                
                <div class="text-muted small" id="paginationInfoText">
                    Menampilkan halaman 1 dari 1
                </div>

                <!-- Pagination di Sebelah Kanan -->
                <nav>
                    <ul class="pagination pagination-sm mb-0" id="paginationContainer">
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>
@await Html.PartialAsync("modalDetail")
@await Html.PartialAsync("modalHapus")
@section Scripts {
    <script src="~/js/transaksi-index.js"></script>
}