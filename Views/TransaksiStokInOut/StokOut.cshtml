@model InventoryMultiGudang.ViewModels.TransaksiStokViewModel
@{
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4 px-4">
    <div class="mb-4">
        <h1 class="h3 fw-bold text-indigo-dark mb-1">Transaksi Pergerakan Stok</h1>
        <p class="text-muted small mb-0">Input mutasi pengurangan (Outbound) stok barang secara massal.</p>
    </div>

    <div class="form-container-custom border-0 shadow-sm p-4 mb-4">
        <form id="formTransaksiStok" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="TipeTransaksi" value="Stock Out" />

            <div class="row g-4 mb-4">
                <div class="col-12 col-md-6">
                    <label class="form-label-custom">Pilih Gudang Target <span class="text-danger">*</span></label>
                    <select asp-for="GudangId" id="GudangId" class="form-select select2-gudang" data-placeholder="-- Pilih Gudang --">
                        <option value=""></option>
                    </select>
                    <span asp-validation-for="GudangId" class="text-danger small fw-semibold validation-warning"></span>
                </div>
            </div>
            
            <div class="row g-4 mb-4">
                <div class="col-12 col-md-6">
                    <div class="p-3 border rounded-3 bg-light-subtle d-flex align-items-center justify-content-between">
                        <div>
                            <label class="form-label-custom fw-bold mb-1" for="IsPenjualan">Status Penjualan</label>
                            <p class="text-muted small mb-0">Aktifkan jika Stock Out ini merupakan transaksi penjualan produk ke pelanggan.</p>
                        </div>
                        <div class="form-check form-switch fs-4">
                            <input class="form-check-input" type="checkbox" role="switch" id="IsPenjualan" name="IsPenjualan" value="true">
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-12 col-md-6">
                    <label class="form-label-custom">Tipe Transaksi</label>
                    <div class="row g-2">
                        <div class="col-6">
                            <input type="radio" class="btn-check" name="tipe_transaksi" id="btn-outbound" checked autocomplete="off">
                            <label class="btn btn-target-select btn-outbound-select w-100 py-2.5 text-center d-flex align-items-center justify-content-center gap-2" for="btn-outbound">
                                <i class="bi bi-box-arrow-up-right fs-5"></i> Stock Out (Outbound)
                            </label>
                        </div>
                        <div class="col-6">
                            <a asp-action="StokIn" asp-controller="TransaksiStokInOut" class="btn btn-target-select btn-inbound-select w-100 py-2.5 text-center d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-box-arrow-in-down fs-5"></i> Stock In (Inbound)
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label-custom">Nomor Referensi (Opsional)</label>
                    <input type="text" asp-for="NomorReferensi" class="form-control" placeholder="E.g. PO-2026-0001, SJ-0092">
                    <span asp-validation-for="NomorReferensi" class="text-danger small fw-semibold validation-warning"></span>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-12">
                    <label class="form-label-custom">Keterangan / Catatan</label>
                    <textarea asp-for="Catatan" class="form-control" rows="4" placeholder="E.g. Penjualan, barang rusak, penyesuaian audit"></textarea>
                    <span asp-validation-for="Catatan" class="text-danger small fw-semibold validation-warning"></span>
                </div>
            </div>

            <div class="border-top pt-4 mt-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center gap-2 fw-bold text-indigo-dark small tracking-wider text-uppercase">
                        <i class="bi bi-boxes text-indigo"></i> Daftar Barang Mutasi
                    </div>
                    <button type="button" id="btnTambahBaris" class="btn btn-action-grid py-1.5 px-3 d-flex align-items-center gap-2 text-danger border-danger-subtle bg-danger-subtle" style="background-color: #fef2f2 !important; color: #ef4444 !important; border: 1px solid #fee2e2 !important; border-radius: 6px;">
                        <i class="bi bi-plus-lg"></i> Tambah Baris
                    </button>
                </div>

                <div id="mutasiContainer">
                    @for (int i = 0; i < Model.Details.Count; i++)
                    {
                        <div class="bg-light-subtle p-3 rounded-3 border mb-3 mutasi-row">
                            <div class="row g-2 align-items-center">
                                <div class="col-12 col-md-6">
                                    <select name="Details[@i].ProdukId" class="form-select field-produk select2-produk" data-placeholder="-- Pilih Produk --">
                                        <option value=""></option>
                                    </select>
                                    <span class="text-danger small fw-semibold validation-warning"></span>
                                </div>
                                <div class="col-12 col-md-3">
                                    <select name="Details[@i].RakId" class="form-select field-rak select2-rak" data-placeholder="-- Pilih Lokasi/Rak --">
                                        <option value=""></option>
                                    </select>
                                    <span class="text-danger small fw-semibold validation-warning"></span>
                                </div>
                                <div class="col-9 col-md-2">
                                    <input type="number" name="Details[@i].Jumlah" class="form-control text-center field-jumlah" value="1" min="1">
                                    <span class="text-danger small fw-semibold validation-warning"></span>
                                </div>
                                <input  type="text" hidden="true" name="Details[@i].SerialNumbers" class="form-control field-sn"/>
                                <div class="col-3 col-md-1 text-center">
                                    <button type="button" class="btn btn-link text-muted p-2 link-danger btn-hapus-baris"><i class="bi bi-trash3 fs-5"></i></button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="card-footer-grid justify-content-between align-items-center pt-3 mt-4">
                <div class="text-muted small d-flex align-items-center gap-2">
                    <i class="bi bi-info-circle text-indigo"></i> Pastikan data input sudah diverifikasi secara fisik.
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-batal-custom btn-sm">
                        <i class="bi bi-arrow-90deg-left"></i> Batal
                    </a>
                    <button type="submit" class="btn btn-emerald-custom btn-sm px-4 py-2 d-flex align-items-center gap-2 shadow-sm">
                        <i class="bi bi-file-earmark-check"></i> Posting Mutasi Stok
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<template id="rowTemplate">
    <div class="bg-light-subtle p-3 rounded-3 border mb-3 mutasi-row">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-6">
                <select name="Details[{INDEX}].ProdukId" class="form-select field-produk select2-produk" data-placeholder="-- Pilih Produk --">
                    <option value=""></option>
                </select>
                <span class="text-danger small fw-semibold validation-warning"></span>
            </div>            
            <div class="col-12 col-md-3">
                <select name="Details[{INDEX}].RakId" class="form-select field-rak select2-rak" data-placeholder="-- Pilih Lokasi/Rak --">
                    <option value=""></option>
                </select>
                <span class="text-danger small fw-semibold validation-warning"></span>
            </div>
            <div class="col-9 col-md-2">
                <input type="number" name="Details[{INDEX}].Jumlah" class="form-control text-center field-jumlah" value="1" min="1">
                <span class="text-danger small fw-semibold validation-warning"></span>
            </div>
            <input type="text" hidden="true" name="Details[{INDEX}].SerialNumbers" class="form-control field-sn"/>                            
            <div class="col-3 col-md-1 text-center">
                <button type="button" class="btn btn-link text-muted p-2 link-danger btn-hapus-baris"><i class="bi bi-trash3 fs-5"></i></button>
            </div>
        </div>
    </div>
</template>

@section Scripts {
    <script src="~/js/TransaksiStokInOut.js"></script>
}