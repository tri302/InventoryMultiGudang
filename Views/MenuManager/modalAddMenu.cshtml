<style>
  .icon-picker-box {
    display: grid;
    /* Membuat kolom otomatis menyesuaikan ukuran (misal minimal 45px per kotak) */
    grid-template-columns: repeat(auto-fill, minmax(45px, 1fr));
    gap: 8px;
    /* Jarak antar kotak ikon */
    max-height: 150px;
    /* Batasi tinggi maksimal jika itemnya banyak */
    overflow-y: auto;
    /* Munculkan scrollbar halus jika melebihi batas tinggi */
    padding: 5px;
  }

  .icon-option {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 45px;
    border: 1px solid #dee2e6;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease-in-out;
  }

  .icon-option:hover {
    background-color: #f8f9fa;
    border-color: #6610f2;
  }
</style>
<div class="modal fade" id="modalAddMenu" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modalAddMenuLabel" aria-hidden="true">
  <div class="modal-dialog modal-md modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">

      <!-- Modal Header -->
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fw-bold" id="modalAddMenuLabel">Add / Edit Menu Item</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <!-- Modal Body -->
      <div class="modal-body pt-3">
        <form id="formAddMenu">
          <!-- Hidden ID untuk mendeteksi Insert (0) atau Update (> 0) -->
          <input type="hidden" id="addMenuId" value="0" />
          <!-- Hidden input untuk menyimpan class icon yang dipilih -->
          <input type="hidden" id="addIconClass" value="bi-speedometer2" />

          <!-- Row 1: Menu Title & Path / URL -->
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label-custom">Menu Title</label>
              <input type="text" id="addMenuTitle" class="form-control" placeholder="e.g. Audit Logs" required>
            </div>
            <div class="col-md-6">
              <label class="form-label-custom">Path / URL</label>
              <input type="text" id="addUrl" class="form-control" placeholder="e.g. /logs" required>
            </div>
          </div>

          <!-- Row 2: Group Name & Parent Menu -->
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label-custom">Group Name</label>
              <select id="addGroupName" class="form-select">
                <option value="">-- Pilih Group --</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label-custom">Parent Menu <span class="text-lowercase fw-normal text-muted">(Optional)</span></label>
              <select id="addParentMenu" class="form-select">
                <option value="">None (Top Level)</option>
              </select>
            </div>
          </div>

          <!-- Row 3: Sort Order -->
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label-custom">Sort Order</label>
              <input type="number" id="addSortOrder" class="form-control" value="1" min="1">
            </div>
          </div>

          <!-- Row 4: Select Icon Grid -->
        <div class="mb-3">
            <label class="form-label-custom">Select Icon</label>
            <div class="icon-picker-box">
                <div class="icon-option" data-icon="bi-grid-fill"><i class="bi bi-grid-fill"></i></div>
                <div class="icon-option" data-icon="bi-people-fill"><i class="bi bi-people-fill"></i></div>
                <div class="icon-option" data-icon="bi-shield-check"><i class="bi bi-shield-check"></i></div>
                <div class="icon-option" data-icon="bi-gear-fill"><i class="bi bi-gear-fill"></i></div>
                <div class="icon-option" data-icon="bi-clock-history"><i class="bi bi-clock-history"></i></div>
                <div class="icon-option" data-icon="bi-list"><i class="bi bi-list"></i></div>
                <div class="icon-option" data-icon="bi-database"><i class="bi bi-database"></i></div>
                <div class="icon-option" data-icon="bi-file-earmark-text"><i class="bi bi-file-earmark-text"></i></div>
                <div class="icon-option" data-icon="bi-folder"><i class="bi bi-folder"></i></div>
                <div class="icon-option" data-icon="bi-bell"><i class="bi bi-bell"></i></div>
                <div class="icon-option" data-icon="bi-book"><i class="bi bi-book"></i></div>
                <div class="icon-option" data-icon="bi-question-circle-fill"><i class="bi bi-question-circle-fill"></i></div>
                <div class="icon-option" data-icon="bi-lock-fill"><i class="bi bi-lock-fill"></i></div>
                <div class="icon-option" data-icon="bi-credit-card"><i class="bi bi-credit-card"></i></div>
                <div class="icon-option" data-icon="bi-bar-chart-line"><i class="bi bi-bar-chart-line"></i></div>
                <div class="icon-option" data-icon="bi-envelope"><i class="bi bi-envelope"></i></div>
                <div class="icon-option" data-icon="bi-building"><i class="bi bi-building"></i></div>
                <div class="icon-option" data-icon="bi-box-seam"><i class="bi bi-box-seam"></i></div>
                <div class="icon-option" data-icon="bi-shop"><i class="bi bi-shop"></i></div>
                <div class="icon-option" data-icon="bi-people"><i class="bi bi-people"></i></div>
                <div class="icon-option" data-icon="bi-person-check"><i class="bi bi-person-check"></i></div>
                <div class="icon-option" data-icon="bi-calendar-week"><i class="bi bi-calendar-week"></i></div>
                <div class="icon-option" data-icon="bi-arrow-left-right"><i class="bi bi-arrow-left-right"></i></div>
                <div class="icon-option" data-icon="bi-truck"><i class="bi bi-truck"></i></div>
                <div class="icon-option" data-icon="bi-clipboard-check"><i class="bi bi-clipboard-check"></i></div>
                <div class="icon-option" data-icon="bi-layers"><i class="bi bi-layers"></i></div>
                <div class="icon-option" data-icon="bi-clock"><i class="bi bi-clock"></i></div>
                <div class="icon-option" data-icon="bi-tags"><i class="bi bi-tags"></i></div>
                <div class="icon-option" data-icon="bi-gear"><i class="bi bi-gear"></i></div>
            </div>
        </div>

          <!-- Row 5: Require Roles & Require Permissions -->
          <div class="row g-3 mb-2">
            <!-- Require Roles List -->
            <div class="col-md-6">
              <label class="form-label-custom">Require Roles</label>
              <div id="rolesCheckboxContainer" class="scroll-checkbox-box border p-2 rounded" style="max-height: 150px; overflow-y: auto;">
                <!-- Render Dinamis via JS -->
              </div>
            </div>

            <!-- Require Permissions List -->
            <div class="col-md-6">
              <label class="form-label-custom">Require Permissions</label>
              <div id="permissionsCheckboxContainer" class="scroll-checkbox-box border p-2 rounded" style="max-height: 150px; overflow-y: auto;">
                <!-- Render Dinamis via JS -->
              </div>
            </div>
          </div>

          <!-- Modal Footer -->
          <div class="modal-footer d-flex justify-content-center gap-2 mt-4">
            <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">
              <i class="bi bi-arrow-90deg-left"></i> Batal
            </button>
            <button type="submit" class="btn btn-success btn-sm px-4">
              <i class="bi bi-check-lg me-1"></i> Simpan Perubahan
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>