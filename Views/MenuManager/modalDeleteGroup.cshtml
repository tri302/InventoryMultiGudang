<!-- MODAL: Delete Menu Group (Small Size) -->
<div class="modal fade" id="modalDeleteGroup" tabindex="-1" aria-labelledby="modalDeleteGroupLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content text-center p-3">

            <!-- Modal Body (Centering Content) -->
            <div class="modal-body pb-2">
                <!-- Warning Icon Circle -->
                <div class="delete-icon-wrapper">
                    <i class="bi bi-trash"></i>
                </div>

                <!-- Title -->
                <h5 class="fw-bold mb-2" id="modalDeleteGroupLabel">Delete Menu Group</h5>

                <!-- Confirmation Text -->
                <p class="text-muted small mb-0">
                    Are you sure you want to delete the group <strong class="text-dark">Inventory Management</strong>?
                    <span class="text-danger">This will permanently delete all menu items belonging to this group.</span>
                </p>
            </div>

            <!-- Modal Footer -->
            <div class="d-flex justify-content-center gap-2">
                <button type="button" class="btn btn-sm btn-batal-modal px-4 py-2" data-bs-dismiss="modal">Batal</button>
                <button type="button" class="btn btn-sm btn-delete-modal px-4 py-2">Ya, Hapus</button>
            </div>
        </div>
    </div>
</div>