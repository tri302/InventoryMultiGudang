@model InventoryMultiGudang.ViewModels.KartuStokDetailViewModel
<!-- Header -->
<div class="mb-4">
    <p class="text-muted small mb-0">
        @Model.KodeGudang - @Model.NamaGudang
        |
        @Model.Sku - @Model.NamaProduk
    </p>
</div>
<!-- Summary Widgets -->
<div class="row g-3 mb-4">
    <!-- Stok Awal -->
    <div class="col-6 col-md-3">
        <div class="summary-card-custom shadow-sm">
            <span class="form-label d-block mb-1">
                Stok Awal
            </span>
            <div class="qty-display">
                @Model.Summary.StokAwal
                <span class="fs-6 text-muted fw-normal">
                    @Model.Satuan
                </span>
            </div>
        </div>
    </div>
    <!-- Total Masuk -->
    <div class="col-6 col-md-3">
        <div class="summary-card-custom shadow-sm">
            <span class="form-label d-block mb-1">
                Total Masuk
            </span>
            <div class="qty-display positive">
                +@Model.Summary.TotalMasuk
                <span class="fs-6 text-muted fw-normal">
                    @Model.Satuan
                </span>
            </div>
        </div>
    </div>
    <!-- Total Keluar -->
    <div class="col-6 col-md-3">
        <div class="summary-card-custom shadow-sm">
            <span class="form-label d-block mb-1">
                Total Keluar
            </span>
            <div class="qty-display negative">
                -@Model.Summary.TotalKeluar
                <span class="fs-6 text-muted fw-normal">
                    @Model.Satuan
                </span>
            </div>
        </div>
    </div>
    <!-- Stok Akhir -->
    <div class="col-6 col-md-3">
        <div class="summary-card-custom shadow-sm">
            <span class="form-label d-block mb-1">
                Stok Akhir
            </span>
            <div class="qty-display">
                @Model.Summary.StokAkhir
                <span class="fs-6 text-muted fw-normal">
                    @Model.Satuan
                </span>
            </div>
        </div>
    </div>
</div>
<!-- Data Table -->
<div class="card border-0 shadow-sm rounded-3 overflow-hidden"
     style="border: 1px solid var(--border-color) !important;">
    <div class="card-header bg-white border-bottom py-3">
        <div class="d-flex align-items-center gap-2 text-indigo-dark fw-bold"
             style="font-size: 0.85rem; letter-spacing: 0.05em; text-transform: uppercase;">
            <i class="bi bi-clock-history text-primary"></i>
            Histori Mutasi
        </div>
    </div>
    @if (Model.Rows.Count == 0)
    {
        <!-- Fallback jika data kosong -->
        <div class="text-center py-5">
            <i class="bi bi-database-exclamation fs-1 text-muted"></i>
            <h6 class="fw-bold mt-3">
                Belum ada data untuk ditampilkan !
            </h6>
            <p class="text-muted small mb-0">
                Belum terdapat histori mutasi stok
                untuk produk dan gudang yang dipilih.
            </p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-mutasi align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 15%;">
                            Tanggal & Waktu
                        </th>
                        <th style="width: 15%;" class="text-center">
                            Tipe
                        </th>
                        <th style="width: 8%;" class="text-center">
                            Jumlah
                        </th>
                        <th style="width: 10%;" class="text-center">
                            Alur Stok
                        </th>
                        <th style="width: 15%;">
                            Referensi
                        </th>
                        <th style="width: 12%;">
                            Pencatat
                        </th>
                        <th style="width: 25%;">
                            Keterangan
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <!-- Tanggal -->
                            <td>
                                <div class="d-flex align-items-center gap-1 text-muted font-monospace"
                                     style="font-size: 0.8rem;">
                                    <i class="bi bi-calendar3"></i>
                                    @row.TanggalPosting.ToString("dd MMM yyyy, HH.mm")
                                </div>
                            </td>
                            <!-- Tipe -->
                            <td class="text-center">
                                <span class="badge-mutasi-custom @row.BadgeClass">
                                    <i class="bi @row.BadgeIcon"></i>
                                    @row.TipeTransaksi
                                </span>
                            </td>
                            <!-- Jumlah -->
                            <td class="text-center fw-bold @(row.Jumlah >= 0 ? "text-success" : "text-danger")">
                                @(row.Jumlah >= 0 ? "+" : "")
                                @row.Jumlah
                            </td>
                            <!-- Running Balance -->
                            <td class="text-center font-monospace text-muted"
                                style="font-size: 0.8rem;">
                                @row.StokSebelum
                                →
                                @row.StokSesudah
                            </td>
                            <!-- Reference -->
                            <td>
                                <div class="fw-semibold font-monospace"
                                     style="font-size: 0.8rem;">
                                    @row.NomorReferensi
                                </div>
                                @if (!string.IsNullOrWhiteSpace(row.KodeLokasi))
                                {
                                    <small class="text-muted font-monospace"
                                           style="font-size: 0.7rem;">
                                        @row.KodeLokasi
                                    </small>
                                }
                            </td>
                            <!-- User -->
                            <td>
                                <span class="text-muted">
                                    <i class="bi bi-person-circle"></i>
                                    @row.Pembuat
                                </span>
                            </td>
                            <!-- Keterangan -->
                            <td>
                                <small class="text-muted">
                                    @row.Catatan
                                </small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>        
    }
</div>