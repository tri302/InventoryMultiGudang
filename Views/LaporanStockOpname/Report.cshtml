@model IEnumerable<InventoryMultiGudang.ViewModels.StockOpnameListDto>

  @{
  Layout = null;
  }
  <!DOCTYPE html>
  <html lang="id">

    <head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>Laporan Rangkuman Stock Opname</title>
      <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
      <link href="~/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
      <style>
        body {
          font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
          background-color: #f8f9fa;
          color: #1e293b;
        }

        .print-container {
          max-width: 900px;
          margin: 20px auto;
          background: #fff;
          padding: 40px;
          border-radius: 8px;
        }

        .border-thick {
          border-bottom: 2px solid #000;
        }

        .text-indigo-dark {
          color: #1e1b4b;
        }

        @@media print {
          .no-print {
            display: none !important;
          }

          body {
            background-color: #fff;
          }

          .print-container {
            max-width: 100%;
            margin: 0;
            padding: 0;
            border: none;
            box-shadow: none;
          }
        }
      </style>
    </head>

    <body>
      <!-- Top Action Bar -->
      <div class="no-print bg-white border-bottom py-2 px-4 d-flex justify-content-between align-items-center sticky-top shadow-sm">
        <div class="d-flex align-items-center gap-2">
          <div class="avatar-box bg-light text-danger d-flex align-items-center justify-content-center rounded" style="width: 36px; height: 36px;">
            <i class="bi bi-file-earmark-pdf-fill fs-5"></i>
          </div>
          <div>
            <h6 class="mb-0 fw-bold">Pratinjau Rangkuman Stock Opname</h6>
            <small class="text-muted">Laporan resmi hasil Rangkuman Stock Opname barang.</small>
          </div>
        </div>
        <div class="d-flex gap-2">
          <button onclick="window.close()" class="btn btn-secondary btn-sm rounded-3"><i class="bi bi-x-lg"></i> Tutup
            Halaman</button>
          <button onclick="window.print()" class="btn btn-success btn-sm rounded-3 btn-print"><i class="bi bi-printer"></i>
            Cetak Laporan</button>
        </div>
      </div>

      <div class="container my-4">
        <!-- Judul Utama Laporan -->
        <div class="text-center report-header mb-4">
          <h3 class="mb-1">LAPORAN RANGKUMAN STOCK OPNAME</h3>
          <p class="mb-0">Sistem Manajemen Aset & Inventaris</p>
        </div>

        <!-- Informasi Meta Dokumen (Dinamis sesuai filter) -->
        <div class="row meta-text mb-2 gy-1">
          <div class="col-6">
            <div><strong>Periode:</strong> @ViewBag.FilterStartDate s/d @ViewBag.FilterEndDate</div>
            <div class="mt-1"><strong>Gudang:</strong> @ViewBag.FilterGudang</div>
          </div>
          <div class="col-6 text-end">
            <div><strong>Tanggal Cetak:</strong> @DateTime.Now.ToString("dd/MM/yyyy, HH.mm.ss")</div>
            <div class="mt-1"><strong>Status Dokumen:</strong> @ViewBag.FilterStatus</div>
          </div>
        </div>

        <hr style="border-top: 2px solid #333; opacity: 1;" class="mb-4">

        <!-- Tabel Data Stock Opname (Looping Data Model) -->
        <div class="table-responsive">
          <table class="table table-report table-hover w-100 mb-0">
            <thead>
              <tr>
                <th style="width: 15%;">Tanggal Posting</th>
                <th style="width: 15%;">Kode Dokumen</th>
                <th style="width: 20%;">Gudang</th>
                <th style="width: 10%;">Jumlah SKU</th>
                <th style="width: 11%;" class="text-success">Selisih Lebih (+)</th>
                <th style="width: 11%;" class="text-danger">Selisih Kurang (-)</th>
                <th style="width: 12%;">Selisih Bersih (Net)</th>
                <th style="width: 11%;">Pencatat</th>
                <th style="width: 10%;">Status</th>
              </tr>
            </thead>
            <tbody class="text-dark">
              @if (Model != null && Model.Any())
              {
              foreach (var item in Model)
              {
              <tr>
                <td>@item.TanggalPosting.ToString("dd MMM yyyy, HH:mm")</td>
                <td class="fw-bold">@item.NoReferensi</td>
                <td>@item.Gudang</td>
                <td>@item.JumlahSku SKU</td>
                <td class="text-success fw-medium">+@item.SelisihLebih unit</td>
                <td class="text-danger fw-medium">@item.SelisihKurang unit</td>
                <td>@item.SelisihBersih unit</td>
                <td>@item.Pencatat</td>
                <td class="fw-bold text-uppercase" style="font-size: 11px;">
                  @(item.Status == 1 ? "SELESAI" : "DRAFT")
                </td>
              </tr>
              }
              }
              else
              {
              <tr>
                <td colspan="9" class="text-center text-muted py-3">Tidak ada data laporan untuk filter yang
                  dipilih.</td>
              </tr>
              }
            </tbody>
          </table>
        </div>

        <!-- Bagian Tanda Tangan Dokumen -->
        <div class="d-flex justify-content-between signature-section px-5 mt-5">
          <div class="text-center">
            <div>Dilaporkan Oleh,</div>
            <div class="signature-space" style="height: 60px;"></div>
            <div class="fw-bold">(_____________________)</div>
            <div class="fw-bold">Warehouse Staff</div>
          </div>
          <div class="text-center">
            <div>Diketahui Oleh,</div>
            <div class="signature-space" style="height: 60px;"></div>
            <div class="fw-bold">(_____________________)</div>
            <div class="fw-bold">Warehouse Manager</div>
          </div>
        </div>
      </div>
    </body>
</html>