<div class="modal fade" id="modalEditUser" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modalEditUserLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-md">
    <div class="modal-content border-0 px-2" style="border-radius: 12px; background-color: #ffffff;">

      <!-- Modal Header -->
      <div class="modal-header border-bottom-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">
        <h5 class="modal-title fw-bold text-dark" id="modalEditUserLabel" style="font-size: 1.15rem;">Edit User
        </h5>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close" style="font-size: 0.75rem; color: #94a3b8;"></button>
      </div>

      <!-- Modal Body (Form) -->
      <div class="modal-body px-4 py-2">
        <form id="formEditUser">
          <!-- Input User Name -->
          <div class="mb-3.5">
            <label class="form-label text-uppercase text-secondary fw-semibold mb-1.5" style="font-size: 0.75rem; letter-spacing: 0.5px; color: #64748b !important;">User
              Name</label>
            <div class="input-group">
              <span class="input-group-text bg-light-subtle border-end-0 text-muted px-3" style="border-color: #e2e8f0; background-color: #f8fafc;"><i class="bi bi-person" style="font-size: 1.1rem;"></i></span>
              <input type="text" id="editFullName" class="form-control border-start-0 ps-1" placeholder="Jane Doe" style="border-color: #e2e8f0; background-color: #f8fafc; font-size: 0.9rem; padding-top: 10px; padding-bottom: 10px;">
            </div>
          </div>

          <!-- Input Email Address -->
          <div class="mb-3.5 mt-3">
            <label class="form-label text-uppercase text-secondary fw-semibold mb-1.5" style="font-size: 0.75rem; letter-spacing: 0.5px; color: #64748b !important;">Email
              Address</label>
            <div class="input-group">
              <span class="input-group-text bg-light-subtle border-end-0 text-muted px-3" style="border-color: #e2e8f0; background-color: #f8fafc;"><i class="bi bi-envelope" style="font-size: 1.05rem;"></i></span>
              <input type="email" id="editEmail" class="form-control border-start-0 ps-1" placeholder="jane.doe@example.com" style="border-color: #e2e8f0; background-color: #f8fafc; font-size: 0.9rem; padding-top: 10px; padding-bottom: 10px;">
            </div>
          </div>

          <!-- Input Password -->
          <div class="mb-4 mt-3">
            <label class="form-label text-uppercase text-secondary fw-semibold mb-1.5" style="font-size: 0.75rem; letter-spacing: 0.5px; color: #64748b !important;">Password
              (Opsional)</label>
            <div class="input-group">
              <span class="input-group-text bg-light-subtle border-end-0 text-muted px-3" style="border-color: #e2e8f0; background-color: #f8fafc;"><i class="bi bi-key" style="font-size: 1.05rem; transform: rotate(-45deg); display: inline-block;"></i></span>
              <input type="password" id="editPassword" class="form-control border-start-0 ps-1" placeholder="Kosongkan jika tidak diubah" style="border-color: #e2e8f0; background-color: #f8fafc; font-size: 0.9rem; padding-top: 10px; padding-bottom: 10px;">
            </div>
          </div>

          <div class="mb-3.5 mt-3">
              <label class="form-label text-uppercase text-secondary fw-semibold mb-1.5" style="font-size: 0.75rem; letter-spacing: 0.5px; color: #64748b !important;">Assign Security Roles ke Data Karyawan</label>
              <select id="editKaryawanId" class="form-select select2-karyawan" style="width: 100%;">
                  <option value="">-- Pilih Karyawan (Opsional) --</option>
              </select>
          </div>
          
          <!-- Section Assign Security Roles -->
          <div class="mb-3">
            <label class="form-label text-uppercase text-secondary fw-semibold mb-1.5" style="font-size: 0.75rem; letter-spacing: 0.5px; color: #64748b !important;">Assign
              Security Roles</label>
            <div class="p-3 border border-1" style="background-color: #f8fafc; border-color: #e2e8f0 !important; border-radius: 10px;">
              <div class="row g-3" style="font-size: 0.9rem; color: #334155;">
                @if (ViewBag.Roles != null)
                {
                foreach (var role in (List<string>)ViewBag.Roles)
                  {
                  <div class="col-6">
                    <div class="form-check p-0 d-flex align-items-center gap-2">
                      <input class="form-check-input m-0" type="checkbox" id="editRole_@role" value="@role" style="width: 16px; height: 16px; border-color: #cbd5e1;">
                      <label class="form-check-label ms-1" for="editRole_@role">@role</label>
                    </div>
                  </div>
                  }
                  }
                  else
                  {
                  <div class="col-12 text-muted small">Tidak ada role tersedia.</div>
                  }
              </div>
            </div>
          </div>
        </form>
      </div>

      <!-- Modal Footer -->
      <div class="modal-footer d-flex justify-content-center gap-2">
        <button type="button" class="btn btn-cancel btn-sm" data-bs-dismiss="modal">
          <i class="bi bi-arrow-90deg-left"></i> Batal
        </button>
        <button type="button" class="btn btn-save btn-sm btn-success">
          <i class="bi bi-check-lg me-1"></i> Simpan Perubahan
        </button>
      </div>
    </div>
  </div>
</div>