@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manajemen User";
}

<style>
    .form-control,
    .form-select,
    .form-input-custom,
    .form-control-custom {
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 0.6rem 0.9rem;
        font-size: 0.95rem;
        color: #1e293b !important;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    /* Styling Manual untuk Validasi Error */
    .is-invalid-custom {
        border-color: #dc3545 !important;
        background-color: #fff8f8 !important;
    }

    .error-text {
        font-size: 0.75rem;
        color: #dc3545;
        margin-top: 0.25rem;
        display: none;
    }
</style>

<div class="container-fluid">
    <!-- Header Bagian Atas -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h4 class="fw-bold text-dark mb-1">User Management</h4>
            <p class="text-muted small mb-0">Create, modify, and assign security roles to system users.</p>
        </div>
        <button class="btn btn-success rounded-pill px-4 btn-sm" data-bs-toggle="modal"
                data-bs-target="#modalCreateUser" onclick="resetCreateForm()">
            <i class="bi bi-person-plus"></i> Add User
        </button>
    </div>

    <!-- Filter & Informasi Total User -->
    <div class="card card-custom p-3 mb-3 shadow-sm border-0">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center gap-2 flex-wrap flex-grow-1" style="max-width: 600px;">
                <div class="input-group" style="max-width: 260px;">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"
                                                                                           style="font-size: 0.85rem;"></i></span>
                        <input type="text" id="searchInput" class="form-control border-start-0 ps-0"
                               placeholder="Search by name or email..." style="font-size: 0.85rem; border-color: #e2e8f0;">
                    </div>
                    <select id="roleFilter" class="form-select text-secondary"
                            style="max-width: 180px; font-size: 0.85rem; border-color: #e2e8f0;">
                        <option value="All Roles" selected>All Roles</option>
                        @if (ViewBag.Roles != null)
                        {
                            @foreach (var role in ViewBag.Roles)
                            {
                                <option value="@role">@role</option>
                            }
                        }
                    </select>
                </div>
            </div>
        </div>

        <!-- Tabel Data User -->
        <div class="card card-custom shadow-sm border-0 overflow-hidden" id="tableContainer">
            <!-- Konten tabel dimuat via AJAX -->
        </div>
    </div>

    @await Html.PartialAsync("Create")
    @await Html.PartialAsync("Edit")
    @await Html.PartialAsync("Delete")

    @section Scripts {
        <script src="~/js/UserManagement.js"></script>
    }