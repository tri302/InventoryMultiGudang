@model InventoryMultiGudang.ViewModels.ProdukItemPrintDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Print Label - @Model.SerialNumber</title>
    <style>
        @@page {
            size: 50mm 30mm;
            margin: 0;
        }

        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 2mm;
            width: 50mm;
            height: 30mm;
            box-sizing: border-box;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #fff;
        }

        .label-card {
            display: flex;
            flex-direction: row;
            align-items: center;
            width: 100%;
            height: 100%;
            padding: 1mm;
            box-sizing: border-box;
        }

        .qr-box {
            width: 40%;
            text-align: center;
        }

            .qr-box img {
                width: 18mm;
                height: 18mm;
                object-fit: contain;
            }

        .info-box {
            width: 60%;
            padding-left: 2mm;
            font-size: 7pt;
            line-height: 1.1;
        }

        .product-name {
            font-weight: bold;
            font-size: 7.5pt;
            margin-bottom: 2px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .sn-code {
            font-family: 'Courier New', Courier, monospace;
            font-weight: bold;
            font-size: 6.5pt;
            color: #111;
            margin-bottom: 2px;
            word-break: break-all;
        }

        .loc-text {
            font-size: 6pt;
            color: #555;
        }

        @@media print {
            .no-print {
                display: none;
            }
        }
    </style>
</head>
<body>

    <div class="label-card">
        <div class="qr-box">
            <img src="@Model.QrCodePath" alt="QR Code" />
        </div>
        <div class="info-box">
            <div class="product-name">@Model.NamaProduk</div>
            <div class="sn-code">@Model.SerialNumber</div>
            <div class="loc-text">@Model.KodeGudang / @Model.KodeRak</div>
        </div>
    </div>

    <script>
        window.onload = function () {
            window.print();
        }
    </script>
</body>
</html>