@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Katalog Produk";
}
<style>
    .form-control,
    .form-select,
    .form-input-custom,
    .form-control-custom {
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 0.6rem 0.9rem;
        font-size: 0.95rem;
        color: #1e293b !important;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    ::before,
    ::after {
        --tw-content: "";
    }

    element {}

    .text-purple-700 {
        --tw-text-opacity: 1;
        color: rgb(126 34 206/var(--tw-text-opacity, 1));
    }

    .uppercase {
        text-transform: uppercase;
    }

    .font-bold {
        font-weight: 700;
    }

    .text-\[9px\] {
        font-size: 9px;
    }

    .py-0\.5 {
        padding-top: .125rem;
        padding-bottom: .125rem;
    }

    .px-1\.5 {
        padding-left: .375rem;
        padding-right: .375rem;
    }

    .bg-purple-50 {
        --tw-bg-opacity: 1;
        background-color: rgb(250 245 255/var(--tw-bg-opacity, 1));
    }

    .border {
        border-width: 1px;
    }

    .rounded {
        border-radius: .25rem;
    }

    .gap-1 {
        gap: .25rem;
    }

    .items-center {
        align-items: center;
    }

    .inline-flex {
        display: inline-flex;
    }

    *,
    ::before,
    ::after {
        box-sizing: border-box;
        border: 0 solid #e5e7eb;
        border-top-width: 0px;
        border-right-width: 0px;
        border-bottom-width: 0px;
        border-left-width: 0px;
    }

    *,
    ::before,
    ::after,
    ::backdrop {
        --tw-ring-offset-shadow: 0 0 #0000;
        --tw-ring-shadow: 0 0 #0000;
        --tw-shadow: 0 0 #0000;
    }

    .text-sm {
        font-size: .875rem;
        line-height: 1.25rem;
    }

    .text-left {
        text-align: left;
    }

    .border-collapse {
        border-collapse: collapse;
    }

    table {
        text-indent: 0;
        border-collapse: collapse;
    }

    .space-y-6> :not([hidden])~ :not([hidden]) {
        --tw-space-y-reverse: 0;
    }

    .shadow-sm {
        --tw-shadow: 0 1px 2px 0 #0000000d;
        --tw-shadow-colored: 0 1px 2px 0 var(--tw-shadow-color);
    }

    .bg-white {
        --tw-bg-opacity: 1;
    }

    .border-slate-200 {
        --tw-border-opacity: 1;
    }

    .text-slate-900 {
        --tw-text-opacity: 1;
        color: rgb(15 23 42/var(--tw-text-opacity, 1));
    }

    .bg-slate-50 {
        --tw-bg-opacity: 1;
    }

    .font-sans {
        font-family: Figtree, ui-sans-serif, system-ui, sans-serif, Apple Color Emoji, Segoe UI Emoji, Segoe UI Symbol, Noto Color Emoji;
    }

    body {
        line-height: inherit;
    }

    html,
    :host {
        -webkit-text-size-adjust: 100%;
        tab-size: 4;
        font-feature-settings: normal;
        font-variation-settings: normal;
        font-family: Figtree, ui-sans-serif, system-ui, sans-serif, Apple Color Emoji, Segoe UI Emoji, Segoe UI Symbol, Noto Color Emoji;
        line-height: 1.5;
    }
</style>
@Html.AntiForgeryToken()

<div class="container-fluid">
    <!-- HEADER SECTION -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold text-indigo-dark mb-1">Katalog Produk</h1>
            <p class="text-muted small mb-0">Kelola item produk inventaris Anda, kelola SKU, satuan pengukuran (UoM),
                serta harga beli dan perolehan.</p>
            </div>
            <div>
                <button class="btn btn-success rounded-pill px-4 btn-sm" data-bs-toggle="modal"
                        data-bs-target="#modalTambahProduk">
                    <i class="bi bi-plus"></i> Tambah Produk
                </button>
            </div>
        </div>

        <!-- FILTER & SEARCH BAR -->
        <div class="card border-0 shadow-sm p-3 mb-4" style="border-radius: 12px;">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text border-end-0 bg-white text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="filterSearch" class="form-control border-start-0 ps-0"
                               placeholder="Cari SKU atau nama produk...">
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <select id="filterKategori" class="form-select text-muted fw-medium">
                        <option selected value="">Semua Kategori</option>
                    </select>
                </div>
                <div class="col-12 col-md d-flex justify-content-md-end align-items-center mt-md-3">
                    <span class="text-muted small fw-medium">Total Produk: <strong id="totalDataCount" class="text-indigo-dark fs-6">0</strong></span>
                    </div>
                </div>
            </div>

            <!-- TABLE AREA -->
            <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 12px;">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 text-nowrap">
                        <thead class="bg-light border-bottom">
                            <tr class="text-uppercase text-muted fw-bold" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                                <th class="ps-4 py-3" style="width: 40%;">Produk</th>
                                <th class="py-3">Kategori</th>
                                <th class="py-3 text-end pe-4">Harga Beli</th>
                                <th class="py-3 text-end pe-4">Harga Perolehan</th>
                                <th class="py-3 text-center">UoM</th>
                                <th class="py-3 text-center" style="width: 120px;">Stok</th>
                                <th class="py-3 text-center pe-4" style="width: 100px;">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="produkTableBody">
                            <!-- Data AJAX diisi di sini -->
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Area -->
                <div class="d-flex justify-content-between align-items-center p-3 border-top" id="paginationContainer">
                    <div class="text-muted small" id="paginationInfo">Menampilkan 0 data</div>
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm mb-0" id="paginationNav"></ul>
                    </nav>
                </div>
            </div>
        </div>

        @await Html.PartialAsync("Create")
        @await Html.PartialAsync("Edit")
        @await Html.PartialAsync("Delete")
        @await Html.PartialAsync("modalRiwayatProduk")

        @section Scripts {
            <script src="~/js/produk.js"></script>
        }