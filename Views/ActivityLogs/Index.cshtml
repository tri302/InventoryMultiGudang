@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Activity Logs";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="mb-4">
        <h3 class="fw-bold text-dark mb-1">Activity Logs</h3>
        <p class="text-muted mb-0">Monitor system actions, security events, and audit trails.</p>
    </div>

    <!-- Top Filter Bar -->
    <div class="card card-custom p-3 mb-4 shadow-sm border-0">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="search-input-group w-100" style="max-width: 400px; position: relative;">
                <i class="bi bi-search" style="position: absolute; left: 12px; top: 12px; color: #adb5bd;"></i>
                <input type="text" id="searchInput" class="form-control ps-5" placeholder="Search logs, events, or users...">
            </div>
            <span class="text-muted small" id="counterInfo">Showing <strong>0</strong> of <strong>0</strong> events</span>
        </div>
    </div>

    <!-- Activity Table Card -->
    <div class="card card-custom overflow-hidden shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-activity align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Causer</th>
                        <th scope="col">Event</th>
                        <th scope="col">Description</th>
                        <th scope="col">Subject</th>
                        <th scope="col">Time</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="logTableBody">
                    <!-- Data akan dirender secara dinamis lewat AJAX -->
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <div class="empty-state-container">
                                <div class="empty-state-icon fs-1 text-muted mb-2">
                                    <i class="bi bi-clock-history"></i>
                                </div>
                                <h6 class="fw-bold text-dark mb-1">No activity logs found</h6>
                                <p class="text-muted small mb-0">Try adjusting your search criteria</p>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        
        <!-- Pagination Footer Section -->
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
            <div class="text-muted small" id="paginationInfoText">
                Menampilkan 0 - 0 dari 0 data
            </div>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0" id="paginationContainer">
                    <!-- Tombol Bootstrap Pagination AJAX -->
                </ul>
            </nav>
        </div>
    </div>
</div>

<!-- Modal Detail Log -->
<div class="modal fade" id="detailLogModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold">Detail Activity Log</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <mb-3 class="mb-3 d-block">
                    <label class="text-muted small fw-bold">CAUSER</label>
                    <p id="modalCauser" class="fw-medium text-dark mb-1">-</p>
                </mb-3>
                <div class="mb-3">
                    <label class="text-muted small fw-bold">EVENT</label>
                    <p id="modalEvent" class="fw-medium text-dark mb-1">-</p>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-bold">DESCRIPTION</label>
                    <p id="modalDescription" class="fw-medium text-dark mb-1">-</p>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-bold">SUBJECT</label>
                    <p id="modalSubject" class="fw-medium text-dark mb-1">-</p>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-bold">TIME</label>
                    <p id="modalTime" class="fw-medium text-dark mb-1">-</p>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">❌ Tutup</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {    
    <script src="~/js/ActivityLogs.js"></script>
}